{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shy Assembly",
  "scopeName": "source.shyasm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#symbols"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.shyasm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.shyasm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "meta.attribute.shyasm",
          "match": "#!\\[(?:mem|stack)\\([^\\]]*\\)\\]"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "begin": "___\\s*DEFINE\\s*___",
          "end": "(?=___\\s*(?:DATA|CODE)\\s*___)",
          "name": "meta.definition-section.shyasm",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "variable.other.constant.shyasm",
              "match": "^\\s*[A-Za-z_$][A-Za-z0-9_.$]*"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.shyasm"
            }
          }
        },
        {
          "begin": "___\\s*DATA\\s*___",
          "end": "(?=___\\s*(?:DEFINE|CODE)\\s*___)",
          "name": "meta.data-section.shyasm",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#data"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.shyasm"
            }
          }
        },
        {
          "begin": "___\\s*CODE\\s*___",
          "end": "(?=___\\s*(?:DEFINE|DATA)\\s*___)",
          "name": "meta.code-section.shyasm",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#directives"
            },
            {
              "include": "#labels"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#registers"
            },
            {
              "include": "#instructions"
            },
            {
              "include": "#symbols"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.shyasm"
            }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^\\s*\\.section\\s+([A-Za-z_$][A-Za-z0-9_.$]*)",
          "captures": {
            "0": {
              "name": "keyword.other.directive.shyasm"
            },
            "1": {
              "name": "entity.name.section.shyasm"
            }
          }
        },
        {
          "match": "^\\s*\\.symbol\\s+([A-Za-z_$][A-Za-z0-9_.$]*)",
          "captures": {
            "0": {
              "name": "keyword.other.directive.shyasm"
            },
            "1": {
              "name": "entity.name.symbol.shyasm"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_.$][A-Za-z0-9_.$]*):",
          "captures": {
            "1": {
              "name": "entity.name.label.shyasm"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.shyasm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.shyasm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.shyasm",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|[01]+[bB]|[0-9]+)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.shyasm",
          "match": "(?i)\\b(?:[0-9a-f]x|ax|bx|cx|dx|ex|fx|pc|segs|sp|tm|status|trap|m[1-4]|rs|exit|epc|cause|ksp|sege)\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.mnemonic.shyasm",
          "match": "^\\s*[a-z][a-z0-9]*\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "variable.other.symbol.shyasm",
          "match": "\\b[A-Za-z_$][A-Za-z0-9_.$]*(?:\\([^)]*\\))?"
        }
      ]
    },
    "data": {
      "patterns": [
        {
          "name": "variable.other.symbol.shyasm",
          "match": "^\\s*[A-Za-z_$][A-Za-z0-9_.$]*(?:\\([^)]*\\))?"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.array.shyasm",
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#symbols"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "name": "meta.byte-array.shyasm",
          "patterns": [
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    }
  }
}
