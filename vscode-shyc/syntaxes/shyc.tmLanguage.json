{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ShyC",
  "scopeName": "source.shyc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#literals"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.shyc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.shyc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.shyc",
          "match": "#!\\[[^\\]]*\\]"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*#\\s*(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.shyc"
            },
            "2": {
              "name": "entity.name.function.preprocessor.shyc"
            }
          }
        },
        {
          "name": "keyword.control.directive.shyc",
          "match": "^\\s*#\\s*(?:include|undef|if|ifdef|ifndef|elif|else|endif|pragma|error|warning)\\b"
        },
        {
          "name": "string.quoted.other.include.shyc",
          "match": "<[A-Za-z0-9_./+-]+\\.(?:shyh|h)>"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.shyc",
          "begin": "(?<![A-Za-z0-9_])(?:u8|u|U|L)?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.shyc",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.shyc",
          "begin": "(?<![A-Za-z0-9_])(?:u8|u|U|L)?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.shyc",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  }
}
