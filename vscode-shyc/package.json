{
  "name": "shyc-vscode",
  "displayName": "ShyC",
  "description": "ShyC language support backed by the shyc compiler.",
  "version": "0.2.1",
  "publisher": "shyproject",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:shyc",
    "onCommand:shyc.restartServer",
    "onCommand:shyc.showOutput"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "shyc",
        "aliases": [
          "ShyC",
          "shyc"
        ],
        "extensions": [
          ".shyc",
          ".shyh"
        ],
        "configuration": "./language/shyc.configuration.json"
      },
      {
        "id": "shyasm",
        "aliases": [
          "Shy Assembly",
          "shyasm"
        ],
        "extensions": [
          ".shy"
        ],
        "configuration": "./language/shyasm.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shyc",
        "scopeName": "source.shyc",
        "path": "./syntaxes/shyc.tmLanguage.json"
      },
      {
        "language": "shyasm",
        "scopeName": "source.shyasm",
        "path": "./syntaxes/shyasm.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "shyc",
        "scopes": {
          "struct": [
            "entity.name.type.struct.shyc",
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "enum": [
            "entity.name.type.enum.shyc",
            "entity.name.type.enum",
            "entity.name.type"
          ],
          "interface": [
            "entity.name.type.trait.shyc",
            "entity.name.type.interface",
            "entity.name.type"
          ],
          "type": [
            "storage.type.shyc",
            "entity.name.type",
            "storage.type"
          ],
          "typeParameter": [
            "variable.parameter.type.shyc",
            "entity.name.type.parameter",
            "variable.parameter"
          ],
          "parameter": [
            "variable.parameter.shyc",
            "variable.parameter"
          ],
          "variable": [
            "variable.other.shyc",
            "variable.other"
          ],
          "property": [
            "variable.other.property.shyc",
            "variable.other.property"
          ],
          "enumMember": [
            "variable.other.enummember.shyc",
            "variable.other.enummember",
            "variable.other.constant"
          ],
          "function": [
            "entity.name.function.shyc",
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member.shyc",
            "entity.name.function.member",
            "entity.name.function"
          ],
          "macro": [
            "entity.name.function.preprocessor.shyc",
            "entity.name.function.preprocessor"
          ],
          "keyword": [
            "keyword.control.shyc",
            "keyword.control",
            "keyword"
          ],
          "modifier": [
            "storage.modifier.shyc",
            "storage.modifier",
            "storage"
          ],
          "operator": [
            "keyword.operator.shyc",
            "keyword.operator"
          ]
        }
      }
    ],
    "configuration": {
      "title": "ShyC",
      "properties": {
        "shyc.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the shyc-lsp binary. Empty means search target/ and the extension's server/ directory."
        },
        "shyc.shyccPath": {
          "type": "string",
          "default": "",
          "description": "Path to the shycc driver used to run const fn probe rounds. Empty means search the workspace target/ directories, the server's directory, and PATH."
        },
        "shyc.libshyPath": {
          "type": "string",
          "default": "",
          "description": "Path to ShyProject's libshy directory (or the ShyProject root). Resolves `use core::...` and `use c::...` imports. Falls back to ~/.shycserver/config.toml."
        },
        "shyc.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra include directories passed to the ShyC preprocessor."
        },
        "shyc.defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra preprocessor definitions, as NAME or NAME=VALUE."
        },
        "shyc.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish compiler diagnostics for ShyC files."
        }
      }
    },
    "commands": [
      {
        "command": "shyc.restartServer",
        "title": "ShyC: Restart Language Server"
      },
      {
        "command": "shyc.showOutput",
        "title": "ShyC: Show Language Server Output"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:server && npm run compile && npm run bundle:extension",
    "compile": "tsc -p ./ --noEmit",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js --watch",
    "build:server": "cargo build --manifest-path server/Cargo.toml",
    "build": "npm run build:server && npm run compile && npm run bundle:extension",
    "bundle:server": "cargo build --release --manifest-path server/Cargo.toml && mkdir -p server/bin && cp server/target/release/shyc-lsp server/bin/shyc-lsp"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^9.0.1",
    "typescript": "^5.3.0"
  }
}
