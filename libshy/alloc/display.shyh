#ifndef SHY_ALLOC_DISPLAY_SHYH
#define SHY_ALLOC_DISPLAY_SHYH

#include <alloc/string.shyh>
#include <alloc/debug.shyh>

/* Human-facing rendering into a Writer: no quotes, no escapes. `{}` in a
   format string uses this trait; `{:?}` uses Debug. */
trait Display {
    fn display(const self *value, WriterRef *out) -> int;
}

fn display_bytes(WriterRef *out, Str text) -> int {
    return out.write_str(text);
}

impl Display for int {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<int>();
        return decimal.debug(value, out);
    }
}

impl Display for unsigned int {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<unsigned int>();
        return decimal.debug(value, out);
    }
}

impl Display for short {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<short>();
        return decimal.debug(value, out);
    }
}

impl Display for unsigned short {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<unsigned short>();
        return decimal.debug(value, out);
    }
}

impl Display for unsigned char {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<unsigned char>();
        return decimal.debug(value, out);
    }
}

impl Display for long {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<long>();
        return decimal.debug(value, out);
    }
}

impl Display for unsigned long {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<unsigned long>();
        return decimal.debug(value, out);
    }
}

impl Display for long long {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<long long>();
        return decimal.debug(value, out);
    }
}

impl Display for unsigned long long {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<unsigned long long>();
        return decimal.debug(value, out);
    }
}

#ifndef __SHY_NO_FLOAT__
impl Display for float {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<float>();
        return decimal.debug(value, out);
    }
}

impl Display for double {
    fn display(const self *value, WriterRef *out) -> int {
        let mut decimal = Debug::from<double>();
        return decimal.debug(value, out);
    }
}
#endif

impl Display for char {
    fn display(const self *value, WriterRef *out) -> int {
        return fmt_putc(out, (int)(unsigned char)*value);
    }
}

impl Display for Str {
    fn display(const self *value, WriterRef *out) -> int {
        return display_bytes(out, *value);
    }
}

impl Display for String {
    fn display(const self *value, WriterRef *out) -> int {
        return display_bytes(out, value.view);
    }
}

#endif
