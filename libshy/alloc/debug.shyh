#ifndef SHY_ALLOC_DEBUG_SHYH
#define SHY_ALLOC_DEBUG_SHYH

#include <alloc/string.shyh>
#include <core/comptime.shyh>
#include <stdint.h>
#ifndef __SHY_NO_FLOAT__
#include <stdio.h>
#endif

/* Rust-style Debug rendering into a Writer: integers are decimal, characters
   are single quoted, strings are quoted and escaped.

   The method is deliberately not generic: a trait value (`Debug::from<int>()`)
   is a table of plain function pointers, so one table type serves every
   concrete type that implements the trait. */
trait Debug {
    fn debug(const self *value, WriterRef *out) -> int;
}

/* Shared building blocks for Debug and Display. */
fn fmt_putc(WriterRef *out, int byte) -> int {
    return out.putc((char)byte);
}

fn fmt_unsigned(WriterRef *out, unsigned int value) -> int {
    char digits[12];
    int start = 12;
    do {
        start--;
        digits[start] = (char)('0' + (int)(value % 10));
        value = value / 10;
    } while (value > 0);
    return out.write_all(digits + start, 12 - start);
}

fn fmt_unsigned_wide(WriterRef *out, unsigned long value) -> int {
    char digits[24];
    int start = 24;
    do {
        start--;
        digits[start] = (char)('0' + (int)(value % 10));
        value = value / 10;
    } while (value > 0);
    return out.write_all(digits + start, 24 - start);
}

#ifndef __SHY_NO_FLOAT__
/* Reuse the C formatter for decimal conversion, then copy into the Writer. */
fn fmt_float(WriterRef *out, double value, int precision) -> int {
    char buffer[64];
    char format[8];
    if (precision < 0) precision = 6;
    if (precision > 9) precision = 9;
    format[0] = '%';
    format[1] = '.';
    format[2] = (char)('0' + precision);
    format[3] = 'f';
    format[4] = 0;
    int length = snprintf(buffer, sizeof(buffer), format, value);
    if (length < 0) { out.failed = 1; return -1; }
    if (length >= (int)sizeof(buffer)) length = (int)sizeof(buffer) - 1;
    return out.write_all(buffer, length);
}
#endif

fn fmt_hex(WriterRef *out, int value) -> int {
    const char *digits = "0123456789abcdef";
    int written = fmt_putc(out, digits[(value >> 4) & 0xf]);
    return written + fmt_putc(out, digits[value & 0xf]);
}

fn fmt_escape_byte(WriterRef *out, int byte) -> int {
    if (byte == '"') {
        return fmt_putc(out, '\\') + fmt_putc(out, '"');
    }
    if (byte == '\\') {
        return fmt_putc(out, '\\') + fmt_putc(out, '\\');
    }
    if (byte == '\n') {
        return fmt_putc(out, '\\') + fmt_putc(out, 'n');
    }
    if (byte == '\t') {
        return fmt_putc(out, '\\') + fmt_putc(out, 't');
    }
    if (byte == '\r') {
        return fmt_putc(out, '\\') + fmt_putc(out, 'r');
    }
    if (byte < 0x20 || byte >= 0x7f) {
        return fmt_putc(out, '\\') + fmt_putc(out, 'x') + fmt_hex(out, byte);
    }
    return fmt_putc(out, byte);
}

impl Debug for int {
    fn debug(const self *value, WriterRef *out) -> int {
        int v = *value;
        if (v < 0) {
            int written = fmt_putc(out, '-');
            return written + fmt_unsigned(out, (unsigned int)0 - (unsigned int)v);
        }
        return fmt_unsigned(out, (unsigned int)v);
    }
}

impl Debug for unsigned int {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_unsigned(out, *value);
    }
}

impl Debug for short {
    fn debug(const self *value, WriterRef *out) -> int {
        int wide = *value;
        let mut inner = Debug::from<int>();
        return inner.debug(&wide, out);
    }
}

impl Debug for unsigned short {
    fn debug(const self *value, WriterRef *out) -> int {
        unsigned int wide = *value;
        let mut inner = Debug::from<unsigned int>();
        return inner.debug(&wide, out);
    }
}

impl Debug for unsigned char {
    fn debug(const self *value, WriterRef *out) -> int {
        unsigned int wide = *value;
        let mut inner = Debug::from<unsigned int>();
        return inner.debug(&wide, out);
    }
}

impl Debug for long {
    fn debug(const self *value, WriterRef *out) -> int {
        long wide = *value;
        if (wide >= 0) return fmt_unsigned_wide(out, (unsigned long)wide);
        int written = fmt_putc(out, '-');
        return written + fmt_unsigned_wide(out, (unsigned long)0 - (unsigned long)wide);
    }
}

impl Debug for unsigned long {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_unsigned_wide(out, *value);
    }
}

impl Debug for long long {
    fn debug(const self *value, WriterRef *out) -> int {
        long wide = (long)*value;
        let mut inner = Debug::from<long>();
        return inner.debug(&wide, out);
    }
}

impl Debug for unsigned long long {
    fn debug(const self *value, WriterRef *out) -> int {
        unsigned long wide = (unsigned long)*value;
        let mut inner = Debug::from<unsigned long>();
        return inner.debug(&wide, out);
    }
}

#ifndef __SHY_NO_FLOAT__
impl Debug for float {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_float(out, (double)*value, 6);
    }
}

impl Debug for double {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_float(out, *value, 6);
    }
}
#endif

impl Debug for char {
    fn debug(const self *value, WriterRef *out) -> int {
        int written = fmt_putc(out, '\'');
        written = written + fmt_escape_byte(out, (int)(unsigned char)*value);
        written = written + fmt_putc(out, '\'');
        return written;
    }
}

impl Debug for Str {
    fn debug(const self *value, WriterRef *out) -> int {
        int written = fmt_putc(out, '"');
        for (int i = 0; i < value.len; i++) {
            written = written + fmt_escape_byte(out, (int)(unsigned char)value.data[i]);
        }
        written = written + fmt_putc(out, '"');
        return written;
    }
}

impl Debug for String {
    fn debug(const self *value, WriterRef *out) -> int {
        let mut inner = Debug::from<Str>();
        return inner.debug(&value.view, out);
    }
}

/* A C string is quoted and escaped just like Str; NULL prints as null. */
fn fmt_debug_cstr(WriterRef *out, const char *text) -> int {
    if (text == 0) {
        return out.write_cstr("null");
    }
    Str view = Str::from_cstr(text);
    let mut inner = Debug::from<Str>();
    return inner.debug(&view, out);
}

impl Debug for char * {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_debug_cstr(out, *value);
    }
}

impl Debug for const char * {
    fn debug(const self *value, WriterRef *out) -> int {
        return fmt_debug_cstr(out, *value);
    }
}

/* Like argv, the array must end with a NULL pointer. */
impl Debug for char ** {
    fn debug(const self *value, WriterRef *out) -> int {
        if (*value == 0) {
            return out.write_cstr("null");
        }
        int written = fmt_putc(out, '[');
        for (int i = 0; (*value)[i] != 0; i++) {
            if (i > 0) {
                written = written + out.write_cstr(", ");
            }
            written = written + fmt_debug_cstr(out, (*value)[i]);
        }
        written = written + fmt_putc(out, ']');
        return out.failed ? -1 : written;
    }
}

/* Other pointers are addresses; their pointees are never read. */
impl Debug for void * {
    fn debug(const self *value, WriterRef *out) -> int {
        uintptr_t address = (uintptr_t)*value;
        const char *digits = "0123456789abcdef";
        char reversed[2 * sizeof(uintptr_t)];
        int count = 0;
        do {
            reversed[count] = digits[address & 15];
            count++;
            address = address >> 4;
        } while (address != 0);
        int written = out.write_cstr("0x");
        while (count > 0) {
            count--;
            written = written + fmt_putc(out, reversed[count]);
        }
        return out.failed ? -1 : written;
    }
}

/* Generates an ordinary Debug impl, using each field's Debug implementation. */
const fn derive_debug(Tokens input) -> Tokens {
    const char *owner = tokens_text(input);
    if (try_provide_impl(owner, "Debug") == 0) {
        return tokens_from_text("");
    }
    int count = field_count(owner);
    let mut text = String::new();
    text.push_cstr("impl Debug for ");
    text.push_cstr(owner);
    text.push_cstr(" { fn debug(const self *value, WriterRef *out) -> int { int written = out.write_cstr(\"");
    text.push_cstr(owner);
    text.push_cstr(" {\");");
    for (int i = 0; i < count; i++) {
        const char *name = field_name(owner, i);
        const char *type = field_type(owner, i);
        int pointer = field_is_pointer(owner, i) && implements(type, "Debug") == 0;
        if (pointer == 0) {
            require_impl(type, "Debug");
        }
        text.push_cstr("written = written + out.write_cstr(\"");
        text.push_cstr(i == 0 ? " " : ", ");
        text.push_cstr(name);
        text.push_cstr(": \"); { let mut field = Debug::from<");
        text.push_cstr(pointer ? "void *" : type);
        text.push_cstr(">(); ");
        if (pointer) {
            text.push_cstr("void *address = (void *)value->");
            text.push_cstr(name);
            text.push_cstr("; written = written + field.debug(&address, out);");
        } else {
            text.push_cstr("written = written + field.debug(&value->");
            text.push_cstr(name);
            text.push_cstr(", out);");
        }
        text.push_cstr(" }");
    }
    text.push_cstr(count == 0 ? "written = written + out.write_cstr(\"}\");" : "written = written + out.write_cstr(\" }\");");
    text.push_cstr("return out.failed ? -1 : written; } }");
    Tokens result = tokens_from_text(text.as_cstr());
    text.drop();
    return result;
}

#endif
