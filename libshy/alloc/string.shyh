#ifndef SHY_ALLOC_STRING_SHYH
#define SHY_ALLOC_STRING_SHYH

#include <core/str.shyh>
#include <core/deref.shyh>
#include <core/buffer.shyh>

/* Owned NUL-terminated byte buffer; bytes are not validated as UTF-8. The
   embedded Str is its read-only Deref view, followed by cap, the allocation
   size, so the layout is `{ const char *data; int len; int cap; }`. Create
   with new(), from_str(), from_cstr(), or with_capacity(); a zero-initialized
   `String s = {0}` also works and lets the first push allocate. An operation
   that may reallocate invalidates copies of the view. A plain local is not
   dropped automatically: call drop() when the buffer is no longer needed, or
   declare it `defer String s = ...` for cleanup at scope exit. */
struct String {
    Str view;
    int cap;
};

impl String {
    fn new(void) -> String;
    fn with_capacity(int capacity) -> String;
    fn from_str(Str text) -> String;
    fn from_cstr(const char *text) -> String;

    fn push(self *s, int byte);
    fn push_str(self *s, Str text);
    fn push_cstr(self *s, const char *text);
    fn reserve(self *s, int additional) -> int;

    fn len(const self *s) -> int;
    fn is_empty(const self *s) -> int;
    fn as_str(const self *s) -> Str;
    fn as_cstr(const self *s) -> const char *;
    fn eq(const self *s, Str other) -> int;
    fn clear(self *s);
    fn clone(const self *s) -> String;
    fn drop(self *s);
}

impl Writer for String {
    /* Appending to a String is a write; the whole text always fits. */
    fn write(self *s, const char *data, int len) -> int {
        Str text = { data, len };
        s.push_str(text);
        return len;
    }
}

impl Buffer for String {
    fn data(self *s) -> char * {
        return (char *)s.view.data;
    }

    fn len(const self *s) -> int {
        return s.view.len;
    }

    fn reserve(self *s, int additional) -> int {
        return String::reserve(s, additional);
    }

    fn set_len(self *s, int newlen) -> int {
        if (newlen < 0 || newlen >= s.cap) {
            return 0;
        }
        s.view.len = newlen;
        ((char *)s.view.data)[newlen] = 0;
        return 1;
    }
}

impl Deref<Str> for String {
    fn deref(const self *s) -> const Str * {
        return &s.view;
    }
}

#endif
