#ifndef SHY_STD_ENV_SHYH
#define SHY_STD_ENV_SHYH

#include <core/str.shyh>
#include <core/option.shyh>

/* 用户程序的命令行参数。内存布局就是 C 的 `int main(int argc, char **argv)`：
   两个字段按声明顺序排列，和同一目标的 C 结构体完全一致。

   #[args_builtin] 只影响 main：按值接收它的 main 在 ABI 上就是
   `int main(int argc, char **argv)`，调用方看到的也是这两个标量参数。
   其他函数按普通 struct 的规则传递，不会展开。 */
#[args_builtin]
struct Args {
    int argc;
    char **argv;
};

/* 从第一个参数走到最后一个，next() 返回 None 表示结束。 */
struct ArgsIter {
    Args args;
    int index;
};

impl Args {
    fn new(int argc, char **argv) -> Args;
    fn len(const self *a) -> int;
    fn get(const self *a, int i) -> Option<Str>;
    fn iter(Args a) -> ArgsIter;
    /* 1 表示命令行里出现了这个标志，例如 has_flag("--verbose")。 */
    fn has_flag(const self *a, const char *flag) -> int;
    /* 标志后面紧跟的那个参数，例如 value_of("-o") 取 "-o out" 里的 "out"。 */
    fn value_of(const self *a, const char *flag) -> Option<Str>;
}

impl ArgsIter {
    fn next(self *it) -> Option<Str>;
}

#endif
