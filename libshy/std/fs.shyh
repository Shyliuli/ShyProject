#ifndef SHY_STD_FS_SHYH
#define SHY_STD_FS_SHYH

#include <core/option.shyh>
#include <alloc/string.shyh>

/* The whole file, or None when it cannot be opened. */
fn read_file(const char *path) -> Option<String>;
/* 1 when every byte was written, 0 otherwise. */
fn write_file(const char *path, Str text) -> int;

#endif
