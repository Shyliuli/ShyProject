// std::env —— 命令行参数的 ShyC 视图。

#include <std/env.shyh>

impl Args {
    pub fn new(int argc, char **argv) -> Args {
        Args args = {argc, argv};
        return args;
    }

    pub fn len(const self *a) -> int {
        return a.argc;
    }

    pub fn get(const self *a, int i) -> Option<Str> {
        if (i < 0 || i >= a.argc) {
            return Option<Str>::None;
        }
        return Option<Str>::Some(Str::from_cstr(a.argv[i]));
    }

    pub fn iter(Args a) -> ArgsIter {
        ArgsIter it = {a, 0};
        return it;
    }

    pub fn has_flag(const self *a, const char *flag) -> int {
        for (int i = 1; i < a.argc; i++) {
            if (Str::from_cstr(a.argv[i]).eq_cstr(flag)) {
                return 1;
            }
        }
        return 0;
    }

    pub fn value_of(const self *a, const char *flag) -> Option<Str> {
        for (int i = 1; i + 1 < a.argc; i++) {
            if (Str::from_cstr(a.argv[i]).eq_cstr(flag)) {
                return Option<Str>::Some(Str::from_cstr(a.argv[i + 1]));
            }
        }
        return Option<Str>::None;
    }
}

impl ArgsIter {
    pub fn next(self *it) -> Option<Str> {
        if (it.index < 0 || it.index >= it.args.argc) {
            return Option<Str>::None;
        }
        Str arg = Str::from_cstr(it.args.argv[it.index]);
        it.index = it.index + 1;
        return Option<Str>::Some(arg);
    }
}
