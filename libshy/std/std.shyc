// std: files and streams, built on the C library's file descriptor calls.

#include <stdio.h>
#include <std/io.shyh>
#include <std/fs.shyh>

static FileWriter global_out = {0};
static FileReader global_in = {0};

// The open/read/write/close calls below are the C library's; the File methods
// have impl-prefixed symbols, so they do not shadow those free functions.
impl File {
    pub fn open(const char *path) -> Result<File, IoError> {
        int fd = open(path, O_RDONLY);
        if (fd < 0) {
            return Result<File, IoError>::Err(OpenFailed);
        }
        File file = {fd};
        return Result<File, IoError>::Ok(file);
    }

    pub fn create(const char *path) -> Result<File, IoError> {
        int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (fd < 0) {
            return Result<File, IoError>::Err(OpenFailed);
        }
        File file = {fd};
        return Result<File, IoError>::Ok(file);
    }

    pub fn read(self *f, char *data, int max_len) -> int {
        return (int)read(f.fd, data, (size_t)max_len);
    }

    pub fn read_to_string(self *f) -> Result<String, IoError> {
        let mut text = String::new();
        while (1) {
            char chunk[256];
            int n = f.read(chunk, 256);
            if (n < 0) {
                text.free();
                return Result<String, IoError>::Err(ReadFailed);
            }
            if (n == 0) {
                break;
            }
            for (int i = 0; i < n; i++) {
                text.push(chunk[i]);
            }
        }
        return Result<String, IoError>::Ok(text);
    }

    pub fn write_all(self *f, Str text) -> Result<void, IoError> {
        int done = 0;
        while (done < text.len) {
            int n = (int)write(f.fd, text.data + done, (size_t)(text.len - done));
            if (n <= 0) {
                return Result<void, IoError>::Err(WriteFailed);
            }
            done = done + n;
        }
        return Result<void, IoError>::Ok;
    }

    pub fn close(self *f) {
        if (f.fd >= 0) {
            close(f.fd);
            f.fd = -1;
        }
    }
}

impl StrReader {
    pub fn new(Str source) -> StrReader {
        StrReader reader = {source, 0};
        return reader;
    }
}

pub fn stdin_reader(void) -> FileReader {
    FileReader reader = {stdin};
    return reader;
}

pub fn stdout_writer(void) -> FileWriter {
    FileWriter writer = {stdout};
    return writer;
}

pub fn stderr_writer(void) -> FileWriter {
    FileWriter writer = {stderr};
    return writer;
}

pub fn set_global_writer(FileWriter writer) {
    global_out = writer;
}

pub fn global_writer(void) -> FileWriter {
    if (!global_out.file) {
        return stdout_writer();
    }
    return global_out;
}

pub fn set_global_reader(FileReader reader) {
    global_in = reader;
}

pub fn global_reader(void) -> FileReader {
    if (!global_in.file) {
        return stdin_reader();
    }
    return global_in;
}

pub fn getc(void) -> int {
    let mut input = global_reader();
    return input.getc();
}

pub fn read_stream(FILE *f) -> String {
    let mut text = String::new();
    let mut c = fgetc(f);
    while (c != EOF) {
        text.push(c);
        c = fgetc(f);
    }
    return text;
}

/* A Str is not NUL-terminated and the C library wants a C string, so copy the
   path into one; `defer` frees it on every return, including the `?`. */
pub fn read_to_string(Str path) -> Result<String, IoError> {
    defer String cpath = String::from_str(path);
    let mut file = File::open(cpath.as_cstr())?;
    let text = file.read_to_string();
    file.close();
    return text;
}

pub fn write_file(Str path, Str text) -> int {
    defer String cpath = String::from_str(path);
    let f = fopen(cpath.as_cstr(), "w");
    if (!f) {
        return 0;
    }
    let written = fwrite(text.data, 1, text.len, f);
    fclose(f);
    return written == (size_t)text.len;
}
