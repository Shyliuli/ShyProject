#ifndef SHY_STD_FMT_SHYH
#define SHY_STD_FMT_SHYH

#include <stdio.h>
#include <core/comptime.shyh>
#include <alloc/string.shyh>
#include <alloc/debug.shyh>
#include <alloc/display.shyh>
#include <std/io.shyh>

/* Formatting over the Display and Debug traits.

   {} renders with Display, {:?} with Debug, {{ and }} are literal braces, and
   {name} inserts that variable. The compiler checks a literal format string
   and expands the call itself: the literal pieces are pushed into a String and
   each argument is rendered by one statically dispatched display/debug call,
   so nothing is parsed at run time. The names the expansion lands on are
   below; they are trivial on purpose.

   scanln! is the exception: it hands its string to sscanf, which reads the C
   conversions at run time, so it keeps one wrapper per argument count. Those
   wrappers are generated at the end of this file. */

fn fmt_begin(void) -> String {
    return String::new();
}

fn fmt_display<A: Display>(A value, String *out) -> int {
    return value.display(out);
}

fn fmt_debug<A: Debug>(A value, String *out) -> int {
    return value.debug(out);
}

/* Ends println!: write the built line to the global writer. */
fn fmt_line(String *line) -> int {
    let mut out = global_writer();
    return out.write_line(line);
}

/* sscanf writes through one pointer per conversion, so scanln! needs a typed
   wrapper for every arity. scanln_generation(8) sets the largest one, the same
   limit the compiler enforces.

   The wrappers are text, and text is built with the ordinary String the rest
   of this file already uses: push_cstr for the fixed pieces, push for one
   character, and fmt_unsigned for the arity number. tokens_from_text then
   hands the finished source to the compiler's lexer. */

const fn append_value_name(String *out, int index) {
    String::push(out, 'a' + index);
}

const fn append_type_name(String *out, int index) {
    String::push(out, 'A' + index);
}

/* "<A, B, C>" */
const fn append_type_parameters(String *out, int count) {
    String::push_cstr(out, "<");
    for (int i = 0; i < count; i++) {
        if (i > 0) {
            String::push_cstr(out, ", ");
        }
        append_type_name(out, i);
    }
    String::push_cstr(out, ">");
}

/* "const char *fmt, A *a, B *b" */
const fn append_pointer_parameters(String *out, int count) {
    String::push_cstr(out, "const char *fmt");
    for (int i = 0; i < count; i++) {
        String::push_cstr(out, ", ");
        append_type_name(out, i);
        String::push_cstr(out, " *");
        append_value_name(out, i);
    }
}

/* ", a, b" */
const fn append_passed_arguments(String *out, int count) {
    for (int i = 0; i < count; i++) {
        String::push_cstr(out, ", ");
        append_value_name(out, i);
    }
}

const fn scanln_wrapper(int count) -> String {
    let mut text = String::new();
    String::push_cstr(&text, "fn scanln");
    fmt_unsigned(&text, (unsigned int)count);
    append_type_parameters(&text, count);
    String::push_cstr(&text, "(");
    append_pointer_parameters(&text, count);
    String::push_cstr(&text, ") -> int { let mut line = String::new(); get_line(&line); return sscanf((const char *)line.data(), fmt");
    append_passed_arguments(&text, count);
    String::push_cstr(&text, "); }");
    return text;
}

const fn scanln_generation(int count) -> Tokens {
    let mut text = String::new();
    for (int n = 1; n <= count; n++) {
        String::push_cstr(&text, " ");
        let wrapper = scanln_wrapper(n);
        String::push_str(&text, wrapper.view);
    }
    return tokens_from_text(text.view.data);
}

scanln_generation(8);

#endif
