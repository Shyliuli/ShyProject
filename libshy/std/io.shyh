#ifndef SHY_STD_IO_SHYH
#define SHY_STD_IO_SHYH

#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <core/result.shyh>
#include <alloc/string.shyh>

/* Why a file operation failed. A bare machine has no file system, so open()
   fails there for every path. */
enum IoError {
    OpenFailed,
    ReadFailed,
    WriteFailed
};

/* An open file. Its only field is the descriptor the C library returned, so
   the layout is the same as the `int` a C caller sees. */
struct File {
    int fd;
};

impl File {
    /* Open an existing file for reading. */
    fn open(const char *path) -> Result<File, IoError>;
    /* Create or truncate a file for writing. */
    fn create(const char *path) -> Result<File, IoError>;
    /* Read up to max_len bytes: a positive count, 0 at end of file, and a
       negative value on error. */
    fn read(self *f, char *data, int max_len) -> int;
    /* Everything left from the current position, or the error that stopped
       the read. */
    fn read_to_string(self *f) -> Result<String, IoError>;
    /* Write every byte, or report the first failure. */
    fn write_all(self *f, Str text) -> Result<void, IoError>;
    /* Close the descriptor. Closing twice is harmless. */
    fn close(self *f);
}

/* Everything left in a stdio stream, up to the end of input. */
fn read_stream(FILE *f) -> String;

/* A cursor over an immutable Str. The view is not advanced; the cursor is. */
struct StrReader {
    Str source;
    int position;
};

impl StrReader {
    fn new(Str source) -> StrReader;
}

impl Reader for StrReader {
    fn read(self *r, char *data, int max_len) -> int {
        int available = r.source.len - r.position;
        if (available <= 0) {
            return 0;
        }
        int n = available < max_len ? available : max_len;
        for (int i = 0; i < n; i++) {
            data[i] = r.source.data[r.position + i];
        }
        r.position = r.position + n;
        return n;
    }
}

/* A FILE as a byte source or destination. */
struct FileReader {
    FILE *file;
};

impl Reader for FileReader {
    fn read(self *r, char *data, int max_len) -> int {
        return (int)fread(data, 1, (size_t)max_len, r.file);
    }
}

struct FileWriter {
    FILE *file;
};

impl Writer for FileWriter {
    fn write(self *w, const char *data, int len) -> int {
        return (int)fwrite(data, 1, (size_t)len, w.file);
    }
}

fn stdin_reader(void) -> FileReader;
fn stdout_writer(void) -> FileWriter;
fn stderr_writer(void) -> FileWriter;

/* The endpoints behind the stream-less helpers. They start at the standard
   streams and stay replaceable for embedded targets and tests. */
fn set_global_writer(FileWriter writer);
fn global_writer(void) -> FileWriter;
fn set_global_reader(FileReader reader);
fn global_reader(void) -> FileReader;

/* Convenience helpers that default to stdio. A program that wants another
   device implements Reader/Writer for it and calls the trait methods. */
fn print<B: Buffer>(B *buffer) -> int {
    let mut out = global_writer();
    let mut writer = out.borrow();
    return writer.write_all(buffer.data(), buffer.len());
}

fn print_line<B: Buffer>(B *buffer) -> int {
    let mut out = global_writer();
    let mut writer = out.borrow();
    int written = writer.write_all(buffer.data(), buffer.len());
    if (written < 0 || writer.putc('\n') < 0) {
        return -1;
    }
    return written;
}

fn get_char(void) -> int;

fn get_line<B: Buffer>(B *buffer) -> int {
    let mut input = global_reader();
    return input.getline(buffer);
}

#endif
