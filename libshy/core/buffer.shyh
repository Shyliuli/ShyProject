#ifndef SHY_CORE_BUFFER_SHYH
#define SHY_CORE_BUFFER_SHYH

#include <core/str.shyh>

/* A writable contiguous byte region with a current length.

   reserve(n) guarantees room for n more bytes after the current length and
   does not change the length. It may move data, so call data() again after a
   successful reserve. set_len(l) commits a new length, and returns 0 when the
   length does not fit. A growable buffer grows here; a fixed one only reports
   whether the room already exists. */
trait Buffer {
    fn data(self *b) -> char *;
    fn len(const self *b) -> int;
    fn reserve(self *b, int additional) -> int;
    fn set_len(self *b, int newlen) -> int;
}

/* Non-owning view of a fixed byte array, wrapped as {array, 0, sizeof array}.
   The view supplies the length and capacity a bare array cannot carry. */
struct BufferView {
    char *ptr;
    int used;
    int size;
};

impl Buffer for BufferView {
    fn data(self *b) -> char * {
        return b.ptr;
    }

    fn len(const self *b) -> int {
        return b.used;
    }

    fn reserve(self *b, int additional) -> int {
        if (additional < 0) {
            return 0;
        }
        return additional <= b.size - b.used;
    }

    fn set_len(self *b, int newlen) -> int {
        if (newlen < 0 || newlen > b.size) {
            return 0;
        }
        b.used = newlen;
        return 1;
    }
}

/* A destination for bytes. write may return a short count, or a negative
   value on failure. borrow keeps the destination alive in its caller. */
trait Writer {
    fn write(self *w, const char *data, int len) -> int;

    fn borrow(self *w) -> WriterRef {
        WriterRef out = {w, Writer::from<self>(), 0};
        return out;
    }
}

/* A borrowed Writer: no buffer, allocation, or ownership of the destination. */
struct WriterRef {
    void *target;
    Writer methods;
    int failed;
};

impl WriterRef {
    fn write_all(self *out, const char *data, int len) -> int {
        if (out.failed) {
            return -1;
        }
        int written = 0;
        while (written < len) {
            int n = out.methods.write(out.target, data + written, len - written);
            if (n <= 0 || n > len - written) {
                out.failed = 1;
                return -1;
            }
            written = written + n;
        }
        return written;
    }

    fn write_str(self *out, Str text) -> int {
        return out.write_all(text.data, text.len);
    }

    fn write_cstr(self *out, const char *text) -> int {
        return out.write_str(Str::from_cstr(text));
    }

    fn putc(self *out, char byte) -> int {
        return out.write_all(&byte, 1);
    }
}

impl Writer for WriterRef {
    fn write(self *out, const char *data, int len) -> int {
        return out.write_all(data, len);
    }

    /* Recursion reuses the original destination instead of chaining adapters. */
    fn borrow(self *out) -> WriterRef {
        return *out;
    }
}

impl Writer for BufferView {
    fn write(self *out, const char *data, int len) -> int {
        int available = out.size - out.used;
        int count = len < available ? len : available;
        for (int i = 0; i < count; i++) {
            out.ptr[out.used + i] = data[i];
        }
        out.used = out.used + count;
        return count;
    }
}

/* A source of bytes. A device implements read; the buffer and line helpers are
   defaults over it. */
trait Reader {
    fn read(self *r, char *data, int max_len) -> int;

    /* Append what is read to any Buffer. Returns the byte count, 0 at end of
       input, and a negative value on a read error the device reports. */
    fn read_buffer<D: Buffer>(self *r, D *buffer, int max_len) -> int {
        if (max_len <= 0) {
            return 0;
        }
        int len = buffer.len();
        if (buffer.reserve(max_len) == 0) {
            return 0;
        }
        int read = r.read(buffer.data() + len, max_len);
        if (read > 0 && buffer.set_len(len + read) == 0) {
            return 0;
        }
        return read;
    }

    /* One byte, or -1 at end of input. */
    fn getc(self *r) -> int {
        char c;
        int n = r.read(&c, 1);
        if (n <= 0) {
            return -1;
        }
        return (int)(unsigned char)c;
    }

    /* Append one line without its newline. Returns the number of bytes
       appended, which is 0 at end of input. */
    fn getline<D: Buffer>(self *r, D *buffer) -> int {
        int start = buffer.len();
        while (1) {
            if (buffer.reserve(1) == 0) {
                return buffer.len() - start;
            }
            char c;
            int n = r.read(&c, 1);
            if (n <= 0) {
                return buffer.len() - start;
            }
            if (c == '\n') {
                return buffer.len() - start;
            }
            int len = buffer.len();
            buffer.data()[len] = c;
            buffer.set_len(len + 1);
        }
    }
}

#endif
