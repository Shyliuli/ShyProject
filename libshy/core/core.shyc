// core: types that need no allocator and no operating system.

#include <core/str.shyh>
#include <core/buffer.shyh>

impl Str {
    pub fn from_cstr(const char *s) -> Str {
        if (s == 0) {
            Str empty = {0, 0};
            return empty;
        }
        let mut n = 0;
        while (s[n]) {
            n = n + 1;
        }
        Str result = {s, n};
        return result;
    }

    pub fn is_empty(const self *s) -> int {
        return s.len == 0;
    }

    pub fn eq(const self *s, Str other) -> int {
        if (s.len != other.len) {
            return 0;
        }
        for (int i = 0; i < s.len; i++) {
            if (s.data[i] != other.data[i]) {
                return 0;
            }
        }
        return 1;
    }

    pub fn eq_cstr(const self *s, const char *other) -> int {
        return s.eq(Str::from_cstr(other));
    }

    pub fn starts_with(const self *s, const char *prefix) -> int {
        Str p = Str::from_cstr(prefix);
        if (p.len > s.len) {
            return 0;
        }
        for (int i = 0; i < p.len; i++) {
            if (s.data[i] != p.data[i]) {
                return 0;
            }
        }
        return 1;
    }

    pub fn ends_with(const self *s, const char *suffix) -> int {
        Str p = Str::from_cstr(suffix);
        if (p.len > s.len) {
            return 0;
        }
        int start = s.len - p.len;
        for (int i = 0; i < p.len; i++) {
            if (s.data[start + i] != p.data[i]) {
                return 0;
            }
        }
        return 1;
    }

    pub fn find(const self *s, Str needle) -> int {
        if (needle.len == 0) {
            return 0;
        }
        if (needle.len > s.len) {
            return -1;
        }
        for (int start = 0; start <= s.len - needle.len; start++) {
            int matched = 1;
            for (int i = 0; i < needle.len; i++) {
                if (s.data[start + i] != needle.data[i]) {
                    matched = 0;
                    break;
                }
            }
            if (matched) {
                return start;
            }
        }
        return -1;
    }

    pub fn slice(const self *s, int start, int len) -> Str {
        if (start < 0 || len < 0 || start > s.len || len > s.len - start) {
            Str empty = {0, 0};
            return empty;
        }
        // A null view has len 0, so only (0, 0) reaches here; do not form
        // `NULL + 0`, which C leaves undefined.
        if (s.data == 0) {
            Str empty = {0, 0};
            return empty;
        }
        Str result = {s.data + start, len};
        return result;
    }

    pub fn trim(const self *s) -> Str {
        int start = 0;
        int end = s.len;
        while (start < end && str_is_space(s.data[start])) {
            start = start + 1;
        }
        while (end > start && str_is_space(s.data[end - 1])) {
            end = end - 1;
        }
        return s.slice(start, end - start);
    }

    pub fn split(const self *s, int separator) -> StrSplit {
        StrSplit split;
        split.rest = *s;
        split.separator = separator;
        split.done = 0;
        return split;
    }

    pub fn parse_int(const self *s) -> Option<int> {
        int i = 0;
        int negative = 0;
        if (s.len > 0 && (s.data[0] == '+' || s.data[0] == '-')) {
            negative = s.data[0] == '-';
            i = 1;
        }
        if (i == s.len) {
            return Option<int>::None();
        }
        unsigned int value = 0;
        while (i < s.len) {
            if (s.data[i] < '0' || s.data[i] > '9') {
                return Option<int>::None();
            }
            unsigned int digit = (unsigned int)(s.data[i] - '0');
            // 214748364 is INT_MAX / 10, so this rejects a value that the
            // next multiply would overflow before the range check below.
            if (value > (unsigned int)214748364) {
                return Option<int>::None();
            }
            value = value * 10 + digit;
            unsigned int limit = (unsigned int)2147483647;
            if (negative) {
                limit = (unsigned int)2147483648;
            }
            if (value > limit) {
                return Option<int>::None();
            }
            i = i + 1;
        }
        if (negative) {
            return Option<int>::Some((int)(0 - value));
        }
        return Option<int>::Some((int)value);
    }
}

impl StrSplit {
    pub fn next(self *s) -> Option<Str> {
        if (s.done) {
            return Option<Str>::None();
        }
        int start = 0;
        while (start < s.rest.len && s.rest.data[start] != (char)s.separator) {
            start = start + 1;
        }
        Str piece = s.rest.slice(0, start);
        if (start == s.rest.len) {
            s.done = 1;
        } else {
            s.rest = s.rest.slice(start + 1, s.rest.len - start - 1);
        }
        return Option<Str>::Some(piece);
    }
}

/* ASCII whitespace, the bytes trim() drops. */
fn str_is_space(char c) -> int {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}
