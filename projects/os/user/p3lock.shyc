#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

#define P3_ITERS 100
#define P3_EXPECTED 200

static void print_int(int value) {
    char buf[12];
    let mut i = 0;
    let mut n = value;

    if (n == 0) {
        fputs("0", stdout);
        return;
    }
    if (n < 0) {
        fputs("-", stdout);
        n = 0 - n;
    }
    while (n > 0 && i < 11) {
        buf[i] = (char)('0' + (n % 10));
        n = n / 10;
        i = i + 1;
    }
    while (i > 0) {
        i = i - 1;
        write(1, &buf[i], 1);
    }
}

static void child_work(void) {
    for (int i = 0; i < P3_ITERS; i++) {
        p3counter(1);
        if (i % 11 == 0) {
            yield();
        }
    }
    exit(0);
}

pub fn main(void) -> int {
    let status = 0;
    let mut done = 0;

    p3counter(0);

    let pid1 = fork();
    if (pid1 < 0) {
        fputs("p3lock fork failed\n", stdout);
        exit(1);
    }
    if (pid1 == 0) {
        child_work();
    }

    let pid2 = fork();
    if (pid2 < 0) {
        fputs("p3lock fork failed\n", stdout);
        exit(1);
    }
    if (pid2 == 0) {
        child_work();
    }

    while (done < 2) {
        let pid = wait(&status);
        if (pid > 0) {
            done = done + 1;
        } else if (pid == 0) {
            yield();
        } else {
            fputs("p3lock wait failed\n", stdout);
            exit(1);
        }
    }

    let count = p3counter(2);
    fputs("p3lock count ", stdout);
    print_int(count);
    fputs("\n", stdout);
    if (count == P3_EXPECTED) {
        fputs("p3lock ok\n", stdout);
        exit(0);
    }

    fputs("p3lock failed\n", stdout);
    exit(1);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
