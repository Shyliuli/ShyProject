#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

#define P2_KILL_CHAN 5151

pub fn main(void) -> int {
    let status = 0;
    let mut pid = fork();

    if (pid < 0) {
        fputs("p2kill fork failed\n", stdout);
        exit(1);
    }
    if (pid == 0) {
        sleep(P2_KILL_CHAN);
        fputs("p2kill child survived\n", stdout);
        exit(2);
    }

    yield();
    if (kill(pid) < 0) {
        fputs("p2kill kill failed\n", stdout);
        exit(1);
    }

    pid = wait(&status);
    if (pid > 0 && status == -1) {
        fputs("p2kill child killed\n", stdout);
        exit(0);
    }

    fputs("p2kill failed\n", stdout);
    exit(1);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
