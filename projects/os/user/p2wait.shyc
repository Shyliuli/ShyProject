#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

fn main(void) -> int {
    let status = 0;
    let mut pid = fork();

    if (pid < 0) {
        fputs("p2wait fork failed\n", stdout);
        exit(1);
    }
    if (pid == 0) {
        yield();
        yield();
        fputs("p2wait child exit\n", stdout);
        exit(7);
    }

    pid = wait(&status);
    if (pid <= 0) {
        fputs("p2wait pid failed\n", stdout);
        exit(1);
    }
    fputs("p2wait parent woke\n", stdout);
    exit(0);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
