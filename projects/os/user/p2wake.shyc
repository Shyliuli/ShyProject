#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

#define P2_WAKE_CHAN 4242

fn main(void) -> int {
    let status = 0;
    let mut pid = fork();

    if (pid < 0) {
        fputs("p2wake fork failed\n", stdout);
        exit(1);
    }
    if (pid == 0) {
        sleep(P2_WAKE_CHAN);
        fputs("p2wake child woke\n", stdout);
        exit(0);
    }

    yield();
    wakeup(P2_WAKE_CHAN);
    pid = wait(&status);
    if (pid <= 0) {
        fputs("p2wake pid failed\n", stdout);
        exit(1);
    }
    fputs("p2wake parent done\n", stdout);
    exit(0);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
