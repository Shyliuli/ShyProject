#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

#define P4_TOTAL 768

static char expected(int n) {
    return (char)('a' + (n % 26));
}

static void print_int(int value) {
    char buf[12];
    let mut i = 0;
    let mut n = value;

    if (n == 0) {
        fputs("0", stdout);
        return;
    }
    if (n < 0) {
        fputs("-", stdout);
        n = 0 - n;
    }
    while (n > 0 && i < 11) {
        buf[i] = (char)('0' + (n % 10));
        n = n / 10;
        i = i + 1;
    }
    while (i > 0) {
        i = i - 1;
        write(1, &buf[i], 1);
    }
}

static int writer(int fd) {
    let mut sent = 0;

    while (sent < P4_TOTAL) {
        let c = expected(sent);
        let w = write(fd, &c, 1);

        if (w <= 0) {
            fputs("p4pipe write failed\n", stdout);
            return -1;
        }
        sent = sent + w;
        if (sent % 111 == 0) {
            yield();
        }
    }
    if (close(fd) < 0) {
        fputs("p4pipe close failed\n", stdout);
        return -1;
    }
    return 0;
}

fn main(void) -> int {
    int fds[2];
    let mut total = 0;
    let mut ok = 1;
    let status = 0;
    let mut bad = -1;
    let mut bad_got = 0;
    let mut bad_want = 0;
    char buf[29];

    if (pipe(fds) < 0) {
        fputs("p4pipe pipe failed\n", stdout);
        exit(1);
    }

    let pid = fork();
    if (pid < 0) {
        fputs("p4pipe fork failed\n", stdout);
        exit(1);
    }
    if (pid == 0) {
        if (close(fds[0]) < 0) {
            fputs("p4pipe child close failed\n", stdout);
            exit(1);
        }
        if (writer(fds[1]) < 0) {
            exit(1);
        }
        exit(0);
    }

    close(fds[1]);
    yield();

    while (total < P4_TOTAL) {
        let n = read(fds[0], buf, 29);
        if (n < 0) {
            fputs("p4pipe read failed\n", stdout);
            exit(1);
        }
        if (n == 0) {
            break;
        }
        for (int i = 0; i < n; i++) {
            if (buf[i] != expected(total + i)) {
                ok = 0;
                if (bad < 0) {
                    bad = total + i;
                    bad_got = (int)buf[i];
                    bad_want = (int)expected(total + i);
                }
            }
        }
        total = total + n;
        if (total % 87 == 0) {
            yield();
        }
    }

    while (wait(&status) == 0) {
        yield();
    }
    let saved_status = status;

    if (ok && total == P4_TOTAL) {
        close(fds[0]);
        fputs("p4pipe ok\n", stdout);
        exit(0);
    }

    close(fds[0]);

    fputs("p4pipe failed total ", stdout);
    print_int(total);
    fputs(" ok ", stdout);
    print_int(ok);
    fputs(" bad ", stdout);
    print_int(bad);
    fputs(" got ", stdout);
    print_int(bad_got);
    fputs(" want ", stdout);
    print_int(bad_want);
    fputs(" status ", stdout);
    print_int(saved_status);
    fputs("\n", stdout);
    exit(1);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
