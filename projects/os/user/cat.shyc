#![no_main]
#![mem(256K)]
#![stack(4K)]

#include "usys.h"
#include "ulib.h"

fn main(void) -> int {
    char buf[64];
    let path = user_arg();
    let fd = path[0] ? open(path) : 0;

    if (fd < 0) {
        exit(1);
    }

    while (1) {
        let n = read(fd, buf, 64);
        if (n <= 0) {
            break;
        }
        write(1, buf, n);
    }

    if (fd != 0) {
        close(fd);
    }
    exit(0);
    return 0;
}

void _start(void) {
    main();
    exit(0);
}
