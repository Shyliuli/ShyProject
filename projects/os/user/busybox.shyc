#![no_main]
#![mem(256K)]
#![stack(16K)]

#include "usys.h"
#include "ulib.h"

#define MAXARGS 10
#define LINE_MAX 128

struct Args {
    char *argv[MAXARGS];
    int argc;
};

struct Text {
    const char *data;
};

impl Args {
    fn clear(self *a) {
        a.argc = 0;
    }

    fn add(self *a, char *s) {
        if (a.argc < MAXARGS) {
            a.argv[a.argc] = s;
            a.argc = a.argc + 1;
        }
    }

    fn get(self *a, int i) -> char * {
        if (i < 0 || i >= a.argc) {
            return (char *)0;
        }
        return a.argv[i];
    }

    fn empty(self *a) -> int {
        return a.argc <= 0;
    }

    fn shift(self *a) -> char * {
        let first = a.get(0);

        if (first == 0) {
            return (char *)0;
        }
        for (int i = 1; i < a.argc; i++) {
            a.argv[i - 1] = a.argv[i];
        }
        a.argc = a.argc - 1;
        return first;
    }

    fn parse(self *a, char *s) -> int {
        let mut i = 0;

        a.clear();
        while (s[i]) {
            while (s[i] == ' ' || s[i] == '\t') {
                i = i + 1;
            }
            if (!s[i]) {
                break;
            }
            a.add(s + i);
            while (s[i] && s[i] != ' ' && s[i] != '\t') {
                i = i + 1;
            }
            if (s[i]) {
                s[i] = 0;
                i = i + 1;
            }
        }
        return a.argc;
    }
};

impl Text {
    fn len(self *t) -> int {
        let mut n = 0;

        while (t.data[n]) {
            n = n + 1;
        }
        return n;
    }

    fn contains(self *t, const char *needle) -> int {
        let mut i = 0;
        Text pat;

        pat.data = needle;
        let n = pat.len();
        if (n == 0) {
            return 1;
        }
        while (t.data[i]) {
            let mut j = 0;

            while (needle[j] && t.data[i + j] == needle[j]) {
                j = j + 1;
            }
            if (j == n) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
};

static char *arg_at(Args *a, int i) {
    if (i < 0 || i >= a->argc) {
        return (char *)0;
    }
    return a->argv[i];
}

static char *skip_spaces(char *s) {
    while (*s == ' ' || *s == '\t') {
        s = s + 1;
    }
    return s;
}

static void trim_right(char *s) {
    let mut n = 0;

    while (s[n]) {
        n = n + 1;
    }
    while (n > 0 && (s[n - 1] == ' ' || s[n - 1] == '\t')) {
        n = n - 1;
        s[n] = 0;
    }
}

static int strlen2(const char *s) {
    Text text;

    text.data = s;
    return text.len();
}

static void print_int(int value) {
    char buf[12];
    let mut i = 0;
    let mut n = value;

    if (n == 0) {
        fputs("0", stdout);
        return;
    }
    if (n < 0) {
        fputs("-", stdout);
        n = 0 - n;
    }
    while (n > 0 && i < 11) {
        buf[i] = (char)('0' + (n % 10));
        n = n / 10;
        i = i + 1;
    }
    while (i > 0) {
        i = i - 1;
        write(1, &buf[i], 1);
    }
}

static int parse_int(const char *s) {
    let mut n = 0;
    let mut i = 0;
    let mut neg = 0;

    if (s[0] == '-') {
        neg = 1;
        i = 1;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        n = n * 10 + (int)(s[i] - '0');
        i = i + 1;
    }
    if (neg) {
        return 0 - n;
    }
    return n;
}

static int contains(const char *s, const char *needle) {
    Text text;

    text.data = s;
    return text.contains(needle);
}

static void make_path(const char *cmd, char *path) {
    let mut i = 0;

    path[0] = '/';
    while (cmd[i] && i < 30) {
        path[i + 1] = cmd[i];
        i = i + 1;
    }
    path[i + 1] = 0;
}

static void append_word(char *dst, int *pos, const char *word) {
    let mut i = 0;

    if (*pos > 0 && *pos < LINE_MAX - 1) {
        dst[*pos] = ' ';
        *pos = *pos + 1;
    }
    while (word[i] && *pos < LINE_MAX - 1) {
        dst[*pos] = word[i];
        *pos = *pos + 1;
        i = i + 1;
    }
    dst[*pos] = 0;
}

static int wait_one(void) {
    let status = 0;
    let mut pid = wait(&status);

    while (pid == 0) {
        yield();
        pid = wait(&status);
    }
    return status;
}

static void exec_argv(Args *args) {
    char path[32];
    char argbuf[LINE_MAX];
    let mut pos = 0;
    let mut i = 1;

    if (args->argc <= 0) {
        exit(1);
    }
    make_path(arg_at(args, 0), path);
    argbuf[0] = 0;
    while (i < args->argc) {
        let w = arg_at(args, i);

        if (streq(w, "<") || streq(w, ">")) {
            i = i + 2;
            continue;
        }
        append_word(argbuf, &pos, w);
        i = i + 1;
    }
    exec(path, argbuf);
    exit(1);
}

static void apply_redirs(Args *args) {
    let mut i = 0;

    while (i < args->argc) {
        let w = arg_at(args, i);

        if (streq(w, "<") && i + 1 < args->argc) {
            let fd = open(arg_at(args, i + 1), O_RDONLY);
            if (fd < 0 || dup2(fd, 0) < 0) {
                exit(1);
            }
            close(fd);
            i = i + 2;
            continue;
        }
        if (streq(w, ">") && i + 1 < args->argc) {
            let fd = open(arg_at(args, i + 1), O_WRONLY | O_CREAT | O_TRUNC);
            if (fd < 0 || dup2(fd, 1) < 0) {
                exit(1);
            }
            close(fd);
            i = i + 2;
            continue;
        }
        i = i + 1;
    }
}

static int run_simple(char *cmdline) {
    Args args;

    trim_right(cmdline);
    cmdline = skip_spaces(cmdline);
    if (!cmdline[0]) {
        return 0;
    }
    if (streq(cmdline, "exit")) {
        exit(0);
    }
    args.parse(cmdline);
    if (args.empty()) {
        return 0;
    }
    if (streq(args.get(0), "exit")) {
        exit(0);
    }

    let pid = fork();
    if (pid < 0) {
        fputs("?\n", stdout);
        return 1;
    }
    if (pid == 0) {
        apply_redirs(&args);
        exec_argv(&args);
    }
    return wait_one();
}

static int run_pipeline(char *left, char *right) {
    Args largs;
    Args rargs;
    int fds[2];

    trim_right(left);
    trim_right(right);
    left = skip_spaces(left);
    right = skip_spaces(right);
    if (!left[0] || !right[0]) {
        fputs("?\n", stdout);
        return 1;
    }
    largs.parse(left);
    rargs.parse(right);
    if (pipe(fds) < 0) {
        fputs("?\n", stdout);
        return 1;
    }

    let lpid = fork();
    if (lpid < 0) {
        close(fds[0]);
        close(fds[1]);
        fputs("?\n", stdout);
        return 1;
    }
    if (lpid == 0) {
        dup2(fds[1], 1);
        close(fds[0]);
        close(fds[1]);
        apply_redirs(&largs);
        exec_argv(&largs);
    }

    let rpid = fork();
    if (rpid < 0) {
        close(fds[0]);
        close(fds[1]);
        fputs("?\n", stdout);
        return 1;
    }
    if (rpid == 0) {
        dup2(fds[0], 0);
        close(fds[0]);
        close(fds[1]);
        apply_redirs(&rargs);
        exec_argv(&rargs);
    }

    close(fds[0]);
    close(fds[1]);
    wait_one();
    return wait_one();
}

static int run_line(char *line) {
    let mut bar = (char *)0;
    let mut andand = (char *)0;
    let mut i = 0;

    while (line[i]) {
        if (line[i] == '|' && bar == 0) {
            bar = line + i;
        }
        if (line[i] == '&' && line[i + 1] == '&' && andand == 0) {
            andand = line + i;
        }
        i = i + 1;
    }

    if (andand != 0) {
        andand[0] = 0;
        andand[1] = 0;
        let status = run_line(line);
        if (status == 0) {
            return run_line(andand + 2);
        }
        return status;
    }
    if (bar != 0) {
        bar[0] = 0;
        return run_pipeline(line, bar + 1);
    }
    return run_simple(line);
}

static int applet_sh(int argc, char *argv[]) {
    char line[LINE_MAX];

    while (1) {
        fputs("$ ", stdout);
        let n = read_line(line, LINE_MAX);
        if (n < 0) {
            exit(2);
        }
        run_line(line);
    }
    return 0;
}

static int applet_echo(int argc, char *argv[]) {
    let mut i = 0;

    while (i < argc) {
        if (i > 0) {
            fputs(" ", stdout);
        }
        fputs(argv[i], stdout);
        i = i + 1;
    }
    fputs("\n", stdout);
    return 0;
}

static int cat_fd(int fd) {
    char buf[64];

    while (1) {
        let n = read(fd, buf, 64);

        if (n < 0) {
            return 1;
        }
        if (n == 0) {
            return 0;
        }
        write(1, buf, n);
    }
}

static int applet_cat(int argc, char *argv[]) {
    let mut status = 0;

    if (argc == 0) {
        return cat_fd(0);
    }
    for (int i = 0; i < argc; i++) {
        let fd = open(argv[i], O_RDONLY);

        if (fd < 0) {
            status = 1;
        } else {
            if (cat_fd(fd) != 0) {
                status = 1;
            }
            close(fd);
        }
    }
    return status;
}

static int applet_ls(int argc, char *argv[]) {
    char name[40];
    let mut i = 0;

    while (1) {
        let r = dirent(i, name, 40);

        if (r < 0) {
            return 1;
        }
        if (r == 0) {
            return 0;
        }
        fputs(name, stdout);
        fputs("\n", stdout);
        i = i + 1;
    }
}

static int applet_mkdir(int argc, char *argv[]) {
    let mut status = 0;

    for (int i = 0; i < argc; i++) {
        if (mkdir(argv[i]) < 0) {
            status = 1;
        }
    }
    return status;
}

static int applet_rm(int argc, char *argv[]) {
    let mut status = 0;

    for (int i = 0; i < argc; i++) {
        if (rm(argv[i]) < 0) {
            status = 1;
        }
    }
    return status;
}

static int applet_pwd(int argc, char *argv[]) {
    fputs("/\n", stdout);
    return 0;
}

static int wc_fd(int fd, const char *name) {
    char buf[64];
    let mut lines = 0;
    let mut words = 0;
    let mut bytes = 0;
    let mut inword = 0;

    while (1) {
        let n = read(fd, buf, 64);

        if (n < 0) {
            return 1;
        }
        if (n == 0) {
            break;
        }
        for (int i = 0; i < n; i++) {
            let c = buf[i];

            bytes = bytes + 1;
            if (c == '\n') {
                lines = lines + 1;
            }
            if (c == ' ' || c == '\n' || c == '\t') {
                inword = 0;
            } else if (!inword) {
                words = words + 1;
                inword = 1;
            }
        }
    }
    print_int(lines);
    fputs(" ", stdout);
    print_int(words);
    fputs(" ", stdout);
    print_int(bytes);
    if (name != 0) {
        fputs(" ", stdout);
        fputs(name, stdout);
    }
    fputs("\n", stdout);
    return 0;
}

static int applet_wc(int argc, char *argv[]) {
    let mut status = 0;

    if (argc == 0) {
        return wc_fd(0, (const char *)0);
    }
    for (int i = 0; i < argc; i++) {
        let fd = open(argv[i], O_RDONLY);

        if (fd < 0) {
            status = 1;
        } else {
            if (wc_fd(fd, argv[i]) != 0) {
                status = 1;
            }
            close(fd);
        }
    }
    return status;
}

static void grep_line(const char *pattern, char *line) {
    if (contains(line, pattern)) {
        fputs(line, stdout);
        fputs("\n", stdout);
    }
}

static int grep_fd(int fd, const char *pattern) {
    char buf[64];
    char line[96];
    let mut pos = 0;

    while (1) {
        let n = read(fd, buf, 64);

        if (n < 0) {
            return 1;
        }
        if (n == 0) {
            break;
        }
        for (int i = 0; i < n; i++) {
            let c = buf[i];

            if (c == '\n') {
                line[pos] = 0;
                grep_line(pattern, line);
                pos = 0;
            } else if (pos < 95) {
                line[pos] = c;
                pos = pos + 1;
            }
        }
    }
    if (pos > 0) {
        line[pos] = 0;
        grep_line(pattern, line);
    }
    return 0;
}

static int applet_grep(int argc, char *argv[]) {
    let mut status = 0;

    if (argc < 1) {
        return 1;
    }
    let pattern = argv[0];
    if (argc == 1) {
        return grep_fd(0, pattern);
    }
    for (int i = 1; i < argc; i++) {
        let fd = open(argv[i], O_RDONLY);

        if (fd < 0) {
            status = 1;
        } else {
            if (grep_fd(fd, pattern) != 0) {
                status = 1;
            }
            close(fd);
        }
    }
    return status;
}

static int applet_ps(int argc, char *argv[]) {
    char line[64];
    let mut i = 0;

    while (1) {
        let r = psline(i, line, 64);

        if (r < 0) {
            return 1;
        }
        if (r == 0) {
            return 0;
        }
        fputs(line, stdout);
        i = i + 1;
    }
}

static int applet_kill(int argc, char *argv[]) {
    let mut status = 0;

    for (int i = 0; i < argc; i++) {
        if (kill(parse_int(argv[i])) < 0) {
            status = 1;
        }
    }
    return status;
}

static int applet_exit(int argc, char *argv[]) {
    exit(0);
    return 0;
}

static int dispatch(const char *name, int argc, char *argv[]) {
    if (streq(name, "sh")) {
        return applet_sh(argc, argv);
    }
    if (streq(name, "echo")) {
        return applet_echo(argc, argv);
    }
    if (streq(name, "cat")) {
        return applet_cat(argc, argv);
    }
    if (streq(name, "ls")) {
        return applet_ls(argc, argv);
    }
    if (streq(name, "mkdir")) {
        return applet_mkdir(argc, argv);
    }
    if (streq(name, "rm")) {
        return applet_rm(argc, argv);
    }
    if (streq(name, "pwd")) {
        return applet_pwd(argc, argv);
    }
    if (streq(name, "wc")) {
        return applet_wc(argc, argv);
    }
    if (streq(name, "grep")) {
        return applet_grep(argc, argv);
    }
    if (streq(name, "ps")) {
        return applet_ps(argc, argv);
    }
    if (streq(name, "kill")) {
        return applet_kill(argc, argv);
    }
    if (streq(name, "exit")) {
        return applet_exit(argc, argv);
    }
    fputs("unknown applet\n", stdout);
    return 1;
}

fn main(void) -> int {
    Args args;
    char argbuf[LINE_MAX];
    let src = user_arg();
    let name = user_argv0();
    let mut i = 0;
    let mut status = 0;

    while (src[i] && i < LINE_MAX - 1) {
        argbuf[i] = src[i];
        i = i + 1;
    }
    argbuf[i] = 0;
    args.parse(argbuf);

    if (streq(name, "busybox") && args.argc > 0) {
        let applet = args.shift();
        status = dispatch(applet, args.argc, args.argv);
    } else {
        status = dispatch(name, args.argc, args.argv);
    }

    exit(status);
    return status;
}

void _start(void) {
    main();
    exit(0);
}
