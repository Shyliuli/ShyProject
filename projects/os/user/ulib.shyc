#![no_main]

// ShyOS 的用户库：为 libshy 实现 open()，其余 C 库直接来自 libshy；
// read/write/close/_exit/sbrk 是 usys 里的系统调用。

#include "usys.h"
#include "ulib.h"

// O_CREAT 对应 create：它新建或截断文件，并以写方式打开。
int open(const char *path, int flags, ...) {
    if (flags & O_CREAT) {
        return sys_create(path);
    }
    return sys_open(path);
}

// Local helpers; static so they cannot clash with libshy's String.
struct Text {
    const char *data;
};

struct Buffer {
    char *data;
    int max;
    int len;
};

impl Text {
    static fn len(self *s) -> int {
        let mut n = 0;

        while (s.data[n]) {
            n = n + 1;
        }
        return n;
    }

    static fn eq(self *s, const char *other) -> int {
        let mut i = 0;

        while (s.data[i] && other[i]) {
            if (s.data[i] != other[i]) {
                return 0;
            }
            i = i + 1;
        }
        return s.data[i] == other[i];
    }

    static fn starts_with(self *s, const char *prefix) -> int {
        let mut i = 0;

        while (prefix[i]) {
            if (s.data[i] != prefix[i]) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }

    static fn find(self *s, const char *needle) -> int {
        let mut i = 0;
        Text pat;

        pat.data = needle;
        let n = pat.len();
        if (n == 0) {
            return 0;
        }
        while (s.data[i]) {
            let mut j = 0;

            while (needle[j] && s.data[i + j] == needle[j]) {
                j = j + 1;
            }
            if (j == n) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
}

impl Buffer {
    static fn init(self *b, char *data, int max) {
        b.data = data;
        b.max = max;
        b.len = 0;
    }

    static fn has_room(self *b) -> int {
        return b.len < b.max - 1;
    }
}

fn user_argv0(void) -> char * {
    return (char *)USER_ARG0_ADDR;
}

fn user_arg(void) -> char * {
    return (char *)USER_ARG_ADDR;
}

fn streq(const char *a, const char *b) -> int {
    Text s;

    s.data = a;
    return s.eq(b);
}

fn read_line(char *buf, int max) -> int {
    Buffer line;

    if (max <= 0) {
        return 0;
    }

    line.init(buf, max);
    while (line.has_room()) {
        char c;
        let r = read(0, &c, 1);
        if (r <= 0) {
            // 一个字节都没读到就 EOF，返回 -1，和空行区分开。
            if (line.len == 0) {
                return -1;
            }
            break;
        }

        if (c == '\n') {
            break;
        }
        line.data[line.len] = c;
        line.len = line.len + 1;
    }
    line.data[line.len] = 0;
    return line.len;
}
