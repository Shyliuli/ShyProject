#![no_main]

#include "usys.h"
#include "ulib.h"

struct String {
    const char *data;
};

struct Buffer {
    char *data;
    int max;
    int len;
};

impl String {
    fn len(self *s) -> int {
        let mut n = 0;

        while (s.data[n]) {
            n = n + 1;
        }
        return n;
    }

    fn eq(self *s, const char *other) -> int {
        let mut i = 0;

        while (s.data[i] && other[i]) {
            if (s.data[i] != other[i]) {
                return 0;
            }
            i = i + 1;
        }
        return s.data[i] == other[i];
    }

    fn starts_with(self *s, const char *prefix) -> int {
        let mut i = 0;

        while (prefix[i]) {
            if (s.data[i] != prefix[i]) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }

    fn find(self *s, const char *needle) -> int {
        let mut i = 0;
        String pat;

        pat.data = needle;
        let n = pat.len();
        if (n == 0) {
            return 0;
        }
        while (s.data[i]) {
            let mut j = 0;

            while (needle[j] && s.data[i + j] == needle[j]) {
                j = j + 1;
            }
            if (j == n) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
}

impl Buffer {
    fn init(self *b, char *data, int max) {
        b.data = data;
        b.max = max;
        b.len = 0;
    }

    fn has_room(self *b) -> int {
        return b.len < b.max - 1;
    }
}

fn user_argv0(void) -> char * {
    return (char *)USER_ARG0_ADDR;
}

fn user_arg(void) -> char * {
    return (char *)USER_ARG_ADDR;
}

fn streq(const char *a, const char *b) -> int {
    String s;

    s.data = a;
    return s.eq(b);
}

fn puts(const char *s) {
    String text;

    text.data = s;
    let n = text.len();
    if (n > 0) {
        write(1, s, n);
    }
}

fn read_line(char *buf, int max) -> int {
    Buffer line;

    if (max <= 0) {
        return 0;
    }

    line.init(buf, max);
    while (line.has_room()) {
        char c;
        let r = read(0, &c, 1);
        if (r <= 0) {
            break;
        }

        if (c == '\n') {
            break;
        }
        line.data[line.len] = c;
        line.len = line.len + 1;
    }
    line.data[line.len] = 0;
    return line.len;
}

fn malloc(int n) -> void * {
    if (n <= 0) {
        return (void *)0;
    }

    let aligned = (n + 3) & ~3;
    if (aligned < n) {
        return (void *)0;
    }

    let p = sbrk(aligned);
    if ((int)p == -1) {
        return (void *)0;
    }
    return p;
}

fn free(void *p) {
    (void)p;
}
