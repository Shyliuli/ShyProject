___CODE___

.section text.trap_save_context
.symbol trap_save_context
    // void trap_save_context(struct trapframe *tf);
    // current->ctx is at offset 0 in struct proc.
    setn 1x current
    geta 1x 1x
    seta 2x 4x

    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x
    addn 1x 4
    addn 2x 4
    geta 3x 2x
    puta 1x 3x

    // ctx.sp is the interrupted user stack pointer from tf->ksp.
    setn 1x current
    geta 1x 1x
    addn 1x CTX_SP_OFF
    setn 2x TF_KSP_OFF
    adda 2x 4x
    geta 3x 2x
    puta 1x 3x

    // ctx.ksp is the process kernel stack top before this trap frame.
    setn 1x current
    geta 1x 1x
    addn 1x CTX_KSP_OFF
    puta 1x 4x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_EPC_OFF
    setn 2x TF_EPC_OFF
    adda 2x 4x
    geta 3x 2x
    puta 1x 3x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_SEGS_OFF
    setn 2x TF_SEGS_OFF
    adda 2x 4x
    geta 3x 2x
    puta 1x 3x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_SEGE_OFF
    setn 2x TF_SEGE_OFF
    adda 2x 4x
    geta 3x 2x
    puta 1x 3x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_VALID_OFF
    setn 3x 1
    puta 1x 3x
    ret

.section text.ctx_set_current_ret
.symbol ctx_set_current_ret
    // void ctx_set_current_ret(uint32_t value);
    setn 1x current
    geta 1x 1x
    addn 1x CTX_R1_OFF
    puta 1x 4x
    ret

.section text.ctx_reset_current
.symbol ctx_reset_current
    // Reset current->ctx for a fresh image at USER_ENTRY.
    // 4x contains the segment-relative initial user stack pointer.
    setn 1x current
    geta 1x 1x
    setn 2x 0
    setn 3x 16
.L.ctx_reset_regs:
    equn 3x 0
    jmpn .L.ctx_reset_regs_done
    puta 1x 2x
    addn 1x 4
    subn 3x 1
    ujmpn .L.ctx_reset_regs
.L.ctx_reset_regs_done:
    setn 1x current
    geta 1x 1x
    addn 1x CTX_SP_OFF
    puta 1x 4x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_KSP_OFF
    setn 2x current
    geta 2x 2x
    addn 2x PROC_KSTACK_OFF
    geta 2x 2x
    addn 2x KSTACK_SIZE
    subn 2x TF_SIZE
    puta 1x 2x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_EPC_OFF
    setn 2x USER_ENTRY
    puta 1x 2x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_SEGS_OFF
    setn 2x current
    geta 2x 2x
    addn 2x PROC_SEGBASE_OFF
    geta 2x 2x
    puta 1x 2x

    setn 1x current
    geta 1x 1x
    addn 1x CTX_SEGE_OFF
    setn 2x current
    geta 2x 2x
    addn 2x PROC_SEGBASE_OFF
    geta 2x 2x
    setn 3x user_seg_size
    geta 3x 3x
    adda 2x 3x
    puta 1x 2x

    // exec 走 iret 返回，弹出 exec 自己压入的 trap 状态，不能再用 enteruser。
    setn 1x current
    geta 1x 1x
    addn 1x CTX_VALID_OFF
    setn 2x 1
    puta 1x 2x
    ret

.section text.ctx_retry_current_syscall
.symbol ctx_retry_current_syscall
    // Re-run the trapped syscall instruction when a blocking syscall wakes.
    setn 1x current
    geta 1x 1x
    addn 1x CTX_EPC_OFF
    geta 2x 1x
    subn 2x 48
    puta 1x 2x
    ret
