___DEFINE___

USER_ENTRY 0x00000100
KSTACK_SIZE 4096
TF_SIZE 88

CTX_R0_OFF 0
CTX_R1_OFF 4
CTX_R2_OFF 8
CTX_R3_OFF 12
CTX_R4_OFF 16
CTX_R5_OFF 20
CTX_R6_OFF 24
CTX_R7_OFF 28
CTX_R8_OFF 32
CTX_R9_OFF 36
CTX_RA_OFF 40
CTX_RB_OFF 44
CTX_RC_OFF 48
CTX_RD_OFF 52
CTX_RE_OFF 56
CTX_RF_OFF 60
CTX_SP_OFF 64
CTX_KSP_OFF 68
CTX_EPC_OFF 72
CTX_SEGS_OFF 76
CTX_SEGE_OFF 80
CTX_VALID_OFF 84

PROC_KSTACK_OFF 100
PROC_SEGBASE_OFF 104

TF_R0_OFF 0
TF_R1_OFF 4
TF_R2_OFF 8
TF_R3_OFF 12
TF_R4_OFF 16
TF_R5_OFF 20
TF_R6_OFF 24
