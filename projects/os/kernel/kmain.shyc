#![no_main]

#include <stdint.shyh>
#include "arch.h"
#include "fs.h"
#include "proc.h"
#include "memlayout.h"

#include <string.shyh>

fn mem_init(void);
void scheduler(void);
void trap_entry(void);

extern proc *current;

#ifndef SHYOS_RISCV
// ShyISA 引导栈：入口汇编按符号取它的栈底。
unsigned char boot_stack[4096];
#endif
unsigned int sched_stack_top = SCHED_STACK_TOP;
unsigned int user_seg_size = USER_SEG_SIZE;

static void load_init(proc *p) {
    let file = fs_lookup("init");
    if (!user_image_layout_ok(file)) {
        arch_uart_putc('!');
        arch_uart_putc('\n');
        arch_shutdown(0);
    }

    arch_space_load(p, file->data, file->size);

    p->ctx.epc = USER_ENTRY;
    p->stack_base = user_image_stack_base(file);
    p->ctx.sp = arch_user_sp(p->stack_base);
    p->sz = file->size;
    p->heap_base = file->size;
    p->name[0] = 'i';
    p->name[1] = 'n';
    p->name[2] = 'i';
    p->name[3] = 't';
    p->name[4] = 0;
}

fn kmain(void) {
    let banner = "ShyOS boot\n";

    mem_init();

#ifdef SHYOS_RISCV
    arch_vm_init();
    arch_vm_enable(arch_vm_kernel_root());
#endif

    proc_init();

    for (int i = 0; banner[i]; i++) {
        arch_uart_putc(banner[i]);
    }

    arch_set_trap((void *)trap_entry);
    arch_set_timer(100);
#ifdef SHYOS_RISCV
    arch_enable_timer();
#endif

    let p = alloc_proc();
    load_init(p);
    p->state = RUNNABLE;

    current = &procs[0];

    // Never returns.
    scheduler();
}
