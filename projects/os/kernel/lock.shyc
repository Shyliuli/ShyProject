#![no_main]

#include "arch.h"

#include "lock.h"
#include "arch.h"

static Lock p3_counter_lock;
static int p3_counter;

impl Lock {
    pub fn init(self *lock) {
        lock.locked = 0;
    }

    pub fn acquire(self *lock) {
        while (arch_atomic_exchange(&lock.locked, 1) != 0) {
        }
    }

    pub fn release(self *lock) {
        lock.locked = 0;
    }
}

pub fn lock_init(Lock *lock) {
    lock.init();
}

pub fn lock_acquire(Lock *lock) {
    lock.acquire();
}

pub fn lock_release(Lock *lock) {
    lock.release();
}

pub fn p3_counter_op(int op) -> int {
    p3_counter_lock.acquire();
    if (op == 0) {
        p3_counter = 0;
    } else if (op == 1) {
        p3_counter = p3_counter + 1;
    }
    let value = p3_counter;
    p3_counter_lock.release();
    return value;
}
