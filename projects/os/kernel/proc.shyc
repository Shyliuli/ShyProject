#![no_main]

#include "arch.h"

#include <stdint.shyh>
#include "fs.h"
#include "lock.h"
#include "memlayout.h"
#include "proc.h"

#include <string.shyh>

pub fn kalloc_page(void) -> void *;
pub fn kfree_page(void *p);
pub fn seg_alloc(void) -> unsigned int;
pub fn seg_free(unsigned int pa);
void scheduler(void);

pub proc procs[NPROC];
pub int next_pid;
static Lock proc_lock;

static void write_u32(unsigned char *p, unsigned int off, unsigned int v) {
    p[off + 0] = (unsigned char)((v >> 24) & 0xff);
    p[off + 1] = (unsigned char)((v >> 16) & 0xff);
    p[off + 2] = (unsigned char)((v >> 8) & 0xff);
    p[off + 3] = (unsigned char)(v & 0xff);
}

// RISC-V is little-endian: program words are stored least significant byte first.
static void write_word_le(unsigned char *p, unsigned int off, unsigned int v) {
    p[off + 0] = (unsigned char)(v & 0xff);
    p[off + 1] = (unsigned char)((v >> 8) & 0xff);
    p[off + 2] = (unsigned char)((v >> 16) & 0xff);
    p[off + 3] = (unsigned char)((v >> 24) & 0xff);
}

static void write_inst(unsigned char *p, unsigned int off,
                       unsigned int op, unsigned int a1, unsigned int a2) {
    write_u32(p, off + 0, op);
    write_u32(p, off + 4, a1);
    write_u32(p, off + 8, a2);
}

static void copy_proc_name(char *dst, const char *src) {
    let mut i = 0;

    while (i < PROC_NAME_MAX - 1 && src[i]) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
}

static const char *proc_state_name(enum procstate state) {
    if (state == UNUSED) {
        return "unused";
    }
    if (state == EMBRYO) {
        return "embryo";
    }
    if (state == SLEEPING) {
        return "sleep";
    }
    if (state == RUNNABLE) {
        return "runble";
    }
    if (state == RUNNING) {
        return "run";
    }
    if (state == ZOMBIE) {
        return "zombie";
    }
    return "?";
}

static void clear_context(context *ctx) {
    for (int i = 0; i < NREG; i++) {
        ctx->regs[i] = 0;
    }
    ctx->sp = 0;
    ctx->ksp = 0;
    ctx->epc = 0;
#ifndef SHYOS_RISCV
    ctx->segs = 0;
    ctx->sege = 0;
#endif
    ctx->valid = 0;
}

static void load_idle_code(proc *p) {
    unsigned char *mem = (unsigned char *)arch_user_ptr(p, 0);

#ifdef SHYOS_RISCV
    // addi a7, x0, 2; ecall; jal x0, -4 (SYS_yield loop)
    write_word_le(mem, 0x100 + 0, 0x00200893);
    write_word_le(mem, 0x100 + 4, 0x00000073);
    write_word_le(mem, 0x100 + 8, 0xFFDFF06F);
#else
    // setn 0x, SYS_yield; syscall; ujmpn syscall
    write_inst(mem, 0x100 + 0, 0x3E, 0x00, 2);
    write_inst(mem, 0x100 + 12, 0x54, 0, 0);
    write_inst(mem, 0x100 + 24, 0x4A, 0x10C, 0);
#endif
}

impl proc {
    pub fn set_state(self *p, enum procstate state) {
        p.state = state;
    }

    pub fn is_state(self *p, enum procstate state) -> int {
        return p.state == state;
    }

    pub fn is_used(self *p) -> int {
        return p.state != UNUSED;
    }

    pub fn is_runnable_user(self *p) -> int {
        return p.state == RUNNABLE && p.pid != 0;
    }

    pub fn is_live_non_idle(self *p) -> int {
        return p.state != UNUSED && p.state != ZOMBIE && p.pid != 0;
    }

    pub fn killed_runnable(self *p) -> int {
        return p.pid != 0 && p.killed && p.state == RUNNABLE;
    }

    pub fn wait_chan(self *p) -> int {
        return 0 - p.pid;
    }

    pub fn sleeping_on(self *p, int chan) -> int {
        return p.state == SLEEPING && p.chan == chan;
    }

    pub fn clear_wait(self *p) {
        p.waiting = 0;
        p.wait_status = 0;
        p.chan = 0;
    }

    pub fn sleep_on(self *p, int chan) {
        p.chan = chan;
        p.state = SLEEPING;
    }

    pub fn wake(self *p) {
        p.chan = 0;
        p.state = RUNNABLE;
    }

    pub fn kill_flag(self *p) {
        p.killed = 1;
        if (p.state == SLEEPING) {
            p.wake();
        }
    }

    pub fn copy_name(self *p, const char *name) {
        copy_proc_name(p.name, name);
    }

    pub fn init_unused(self *p) {
        clear_context(&p.ctx);
        p.state = UNUSED;
        p.pid = 0;
        p.parent = -1;
        p.kstack = 0;
        p.segbase = 0;
        p.sz = 0;
        p.heap_base = 0;
        p.stack_base = USER_STACK_DEFAULT_BASE;
        p.xstatus = 0;
        p.chan = 0;
        p.killed = 0;
        p.waiting = 0;
        p.wait_status = 0;
        p.stdin_fd = -1;
        p.stdout_fd = -1;
        p.open_fds = 0;
        p.name[0] = 0;
    }

    pub fn init_embryo(self *p, int pid) {
        p.state = EMBRYO;
        p.pid = pid;
        p.parent = -1;
        p.chan = 0;
        p.killed = 0;
        p.stdin_fd = -1;
        p.stdout_fd = -1;
        p.open_fds = 0;
        p.name[0] = 0;
    }

    pub fn init_user_context(self *p) {
        for (int r = 0; r < NREG; r++) {
            p.ctx.regs[r] = 0;
        }
#ifdef SHYOS_RISCV
        p.ctx.ksp = p.kstack + 4096; /* stacks grow down on RISC-V */
#else
        p.ctx.ksp = p.kstack;
#endif
        p.ctx.sp = arch_user_sp(USER_STACK_DEFAULT_BASE);
#ifndef SHYOS_RISCV
        p.ctx.segs = p.segbase;
        p.ctx.sege = p.segbase + USER_SEG_SIZE;
#else
        p.ctx.space = p.segbase;
#endif
        p.ctx.epc = USER_ENTRY;
        p.ctx.valid = 0;
        p.sz = 0;
        p.heap_base = 0;
        p.stack_base = USER_STACK_DEFAULT_BASE;
        p.xstatus = 0;
        p.chan = 0;
        p.killed = 0;
        p.waiting = 0;
        p.wait_status = 0;
        p.stdin_fd = -1;
        p.stdout_fd = -1;
        p.open_fds = 0;
        p.name[0] = 0;
    }

    pub fn free_resources(self *p) {
        if (p.kstack != 0) {
            kfree_page((void *)p.kstack);
        }
        arch_space_free(p);
    }
}

static proc *find_proc_locked(int pid) {
    for (int i = 0; i < NPROC; i++) {
        if (procs[i].is_used() && procs[i].pid == pid) {
            return &procs[i];
        }
    }
    return 0;
}

static int has_live_non_idle_locked(void) {
    for (int i = 0; i < NPROC; i++) {
        if (procs[i].is_live_non_idle()) {
            return 1;
        }
    }
    return 0;
}

static void copy_wait_status(proc *parent, unsigned int addr, int value) {
    if (addr != 0) {
        if (addr <= USER_SEG_SIZE - 4) {
            arch_space_write(parent, addr, &value, sizeof(value));
        }
    }
}

static void free_proc_locked(proc *p);
static void wakeup_locked(int chan);
static void proc_exit_locked(int status);

static void wake_waiting_parent_locked(proc *parent, proc *child) {
    let pid = child->pid;

    copy_wait_status(parent, parent->wait_status, child->xstatus);
    if (child == current) {
        /* Reap after switching away from this kernel stack and address space.
           The parent has already collected the status, so detach the zombie. */
        child->parent = -1;
    } else {
        free_proc_locked(child);
    }
    parent.clear_wait();
    ctx_set_ret(&parent->ctx, pid);
    parent.set_state(RUNNABLE);
}

pub fn proc_init(void) {
    lock_init(&proc_lock);
    for (int i = 0; i < NPROC; i++) {
        procs[i].init_unused();
    }

    next_pid = 1;
    let idle = alloc_proc();
    idle->pid = 0;
    idle->parent = -1;
    idle.set_state(RUNNABLE);
    next_pid = 1;
    load_idle_code(idle);
}

pub fn alloc_proc(void) -> proc * {
    proc *p = 0;

    lock_acquire(&proc_lock);
    for (int i = 0; i < NPROC; i++) {
        if (procs[i].is_state(UNUSED)) {
            p = &procs[i];
            p.init_embryo(next_pid);
            next_pid = next_pid + 1;
            break;
        }
    }
    lock_release(&proc_lock);

    if (p == 0) {
        return 0;
    }

    p->kstack = (unsigned int)kalloc_page();
    arch_space_alloc(p);

    lock_acquire(&proc_lock);
    p.init_user_context();
    lock_release(&proc_lock);

    return p;
}

static void free_proc_locked(proc *p) {
    if (p == 0) {
        return;
    }

    p.free_resources();
    p.init_unused();
}

pub fn free_proc(proc *p) {
    lock_acquire(&proc_lock);
    free_proc_locked(p);
    lock_release(&proc_lock);
}

pub fn fork(void) -> int {
    let child = alloc_proc();
    let stdin_fd = current->stdin_fd;
    let stdout_fd = current->stdout_fd;
    let open_fds = current->open_fds;

    if (child == 0) {
        lock_acquire(&proc_lock);
        ctx_set_ret(&current->ctx, -1);
        lock_release(&proc_lock);
        return -1;
    }

    if (arch_space_copy(current, child) < 0) {
        free_proc(child);
        return -1;
    }
    arch_fence_i();

    lock_acquire(&proc_lock);
    child->ctx = current->ctx;
#ifdef SHYOS_RISCV
    child->ctx.ksp = child->kstack + 4096; /* its own kernel stack, not the parent's */
#else
    child->ctx.ksp = child->kstack;
#endif
#ifndef SHYOS_RISCV
    child->ctx.segs = child->segbase;
    child->ctx.sege = child->segbase + USER_SEG_SIZE;
#else
    child->ctx.space = child->segbase;
#endif
    ctx_set_ret(&child->ctx, 0);
    child->parent = current->pid;
    child.set_state(RUNNABLE);
    child->sz = current->sz;
    child->heap_base = current->heap_base;
    child->stack_base = current->stack_base;
    child->xstatus = 0;
    child->killed = 0;
    child.clear_wait();
    child->stdin_fd = stdin_fd;
    child->stdout_fd = stdout_fd;
    child->open_fds = open_fds;
    child.copy_name(current->name);
    file_dup_open_mask(open_fds);
    if (stdin_fd >= 3) {
        file_dup(stdin_fd);
    }
    if (stdout_fd >= 3) {
        file_dup(stdout_fd);
    }

    ctx_set_ret(&current->ctx, child->pid);
    let child_pid = child->pid;
    lock_release(&proc_lock);
    return child_pid;
}

static void proc_exit_locked(int status) {
    let pid = current->pid;

    current->xstatus = status;
    current.clear_wait();
    current.set_state(ZOMBIE);
    if (status == 2 && current->parent == 1) {
        arch_shutdown(0);
    }
    let parent = find_proc_locked(current->parent);
    if (parent != 0 &&
        parent.is_state(SLEEPING) &&
        parent->waiting) {
        wake_waiting_parent_locked(parent, current);
    } else if (parent != 0) {
        wakeup_locked(parent.wait_chan());
    }

    for (int i = 0; i < NPROC; i++) {
        if (procs[i].parent == pid) {
            if (procs[i].state == ZOMBIE) {
                free_proc_locked(&procs[i]);
            } else {
                procs[i].parent = 1;
            }
        }
    }

    if (pid != 0 && !has_live_non_idle_locked()) {
        arch_shutdown(0);
    }
    if (pid == 1) {
        arch_shutdown(0);
    }
}

pub fn proc_exit(int status) {
    current->xstatus = status;
    if (current->stdin_fd >= 3 || current->stdout_fd >= 3 || current->open_fds != 0) {
        file_close_proc();
    }
    lock_acquire(&proc_lock);
    proc_exit_locked(current->xstatus);
    lock_release(&proc_lock);
}

#undef exit
void exit(int status) {
    proc_exit(status);
}

pub fn wait(int *status) -> int {
    while (1) {
        let mut have_child = 0;

        lock_acquire(&proc_lock);
        for (int i = 0; i < NPROC; i++) {
            if (procs[i].parent == current->pid) {
                have_child = 1;
                if (procs[i].is_state(ZOMBIE)) {
                    let pid = procs[i].pid;
                    copy_wait_status(current, (unsigned int)status, procs[i].xstatus);
                    current.clear_wait();
                    free_proc_locked(&procs[i]);
                    lock_release(&proc_lock);
                    return pid;
                }
            }
        }

        if (!have_child) {
            lock_release(&proc_lock);
            return -1;
        }
        if (current->killed) {
            lock_release(&proc_lock);
            return -1;
        }

        current->waiting = 1;
        current->wait_status = (unsigned int)status;
        current.sleep_on(current.wait_chan());
        lock_release(&proc_lock);
        return 0;
    }
}

pub fn getpid(void) -> int {
    lock_acquire(&proc_lock);
    let pid = current->pid;
    lock_release(&proc_lock);
    return pid;
}

pub fn kill(int pid) -> int {
    lock_acquire(&proc_lock);
    let p = find_proc_locked(pid);
    if (p == 0 || p->pid == 0) {
        lock_release(&proc_lock);
        return -1;
    }

    p.kill_flag();
    lock_release(&proc_lock);
    return 0;
}

pub fn sleep(int chan) -> int {
    if (chan == 0) {
        return -1;
    }
    if (current == 0 || current->pid == 0) {
        return -1;
    }

    lock_acquire(&proc_lock);
    current.sleep_on(chan);
    lock_release(&proc_lock);
    return 0;
}

static void wakeup_locked(int chan) {
    if (chan == 0) {
        return;
    }

    for (int i = 0; i < NPROC; i++) {
        if (procs[i].sleeping_on(chan)) {
            procs[i].wake();
        }
    }
}

pub fn wakeup(int chan) {
    lock_acquire(&proc_lock);
    wakeup_locked(chan);
    lock_release(&proc_lock);
}

pub fn yield(void) {
    lock_acquire(&proc_lock);
    if (current.is_state(RUNNING)) {
        current.set_state(RUNNABLE);
    }
    lock_release(&proc_lock);
    scheduler();
}

pub fn proc_sbrk(int n) -> int {
    lock_acquire(&proc_lock);
    if (current == 0 || current->pid == 0) {
        lock_release(&proc_lock);
        return -1;
    }

    let old = current->sz;
    let mut new_break = old;
    let mut stack_base = current->stack_base;
    if (stack_base == 0 || stack_base > USER_SEG_SIZE) {
        stack_base = USER_STACK_DEFAULT_BASE;
    }

    if (n >= 0) {
        let inc = (unsigned int)n;

        new_break = old + inc;
        if (new_break < old) {
            lock_release(&proc_lock);
            return -1;
        }
    } else {
        let dec = 0 - (unsigned int)n;

        if (dec > old || old - dec < current->heap_base) {
            lock_release(&proc_lock);
            return -1;
        }
        new_break = old - dec;
    }

    if (new_break > USER_SEG_SIZE || new_break >= stack_base) {
        lock_release(&proc_lock);
        return -1;
    }

    current->sz = new_break;
    lock_release(&proc_lock);
    return (int)old;
}

pub fn proc_next(void) -> proc * {
    let mut start = 0;

    lock_acquire(&proc_lock);
    for (int i = 0; i < NPROC; i++) {
        if (&procs[i] != current && procs[i].state == ZOMBIE && procs[i].parent == -1) {
            free_proc_locked(&procs[i]);
        }
    }
    if (current != 0) {
        for (int i = 0; i < NPROC; i++) {
            if (&procs[i] == current) {
                start = i + 1;
                break;
            }
        }
    }

    for (int n = 0; n < NPROC; n++) {
        int i = (start + n) % NPROC;
        if (procs[i].is_runnable_user()) {
            if (procs[i].killed) {
                current = &procs[i];
                proc_exit_locked(-1);
                continue;
            }
            let next = &procs[i];
            lock_release(&proc_lock);
            return next;
        }
    }

    if (current != 0 && current.is_runnable_user()) {
        let next = current;
        lock_release(&proc_lock);
        return next;
    }

    let next = &procs[0];
    lock_release(&proc_lock);
    return next;
}

pub fn proc_set_current_state(enum procstate state) {
    lock_acquire(&proc_lock);
    if (current != 0) {
        current.set_state(state);
    }
    lock_release(&proc_lock);
}

pub fn proc_current_state_is(enum procstate state) -> int {
    let mut same = 0;

    lock_acquire(&proc_lock);
    if (current != 0 && current.is_state(state)) {
        same = 1;
    }
    lock_release(&proc_lock);
    return same;
}

pub fn proc_current_killed_runnable(void) -> int {
    let mut killed = 0;

    lock_acquire(&proc_lock);
    if (current != 0 && current.killed_runnable()) {
        killed = 1;
    }
    lock_release(&proc_lock);
    return killed;
}

pub fn proc_live_non_idle_exists(void) -> int {
    lock_acquire(&proc_lock);
    let live = has_live_non_idle_locked();
    lock_release(&proc_lock);
    return live;
}

pub fn proc_set_current_size(unsigned int sz) {
    lock_acquire(&proc_lock);
    if (current != 0) {
        current->sz = sz;
        current->heap_base = sz;
    }
    lock_release(&proc_lock);
}

pub fn proc_set_current_stack_base(unsigned int stack_base) {
    lock_acquire(&proc_lock);
    if (current != 0) {
        current->stack_base = stack_base;
    }
    lock_release(&proc_lock);
}

pub fn proc_set_current_name(const char *name) {
    lock_acquire(&proc_lock);
    if (current != 0) {
        current.copy_name(name);
    }
    lock_release(&proc_lock);
}

pub fn proc_psline(int index, char *user_buf, int max) -> int {
    char dst[64];
    let addr = (unsigned int)user_buf;
    let mut seen = 0;
    let mut pos = 0;

    if (index < 0) {
        return 0;
    }
    if (max <= 0 || addr >= USER_SEG_SIZE || (unsigned int)max > USER_SEG_SIZE - addr) {
        return -1;
    }
    if (max > sizeof(dst)) max = sizeof(dst);

    lock_acquire(&proc_lock);
    for (int i = 0; i < NPROC; i++) {
        if (procs[i].is_used()) {
            if (seen == index) {
                let mut pid = procs[i].pid;
                let mut divisor = 1;
                let state_name = proc_state_name(procs[i].state);
                let mut name = procs[i].name;
                let mut j = 0;

                if (pid == 0) {
                    if (pos < max - 1) {
                        dst[pos] = '0';
                        pos = pos + 1;
                    }
                } else {
                    if (pid < 0) {
                        if (pos < max - 1) {
                            dst[pos] = '-';
                            pos = pos + 1;
                        }
                        pid = 0 - pid;
                    }
                    while (pid / divisor >= 10) {
                        divisor = divisor * 10;
                    }
                    while (divisor > 0) {
                        if (pos < max - 1) {
                            dst[pos] = (char)('0' + ((pid / divisor) % 10));
                            pos = pos + 1;
                        }
                        divisor = divisor / 10;
                    }
                }
                if (pos < max - 1) {
                    dst[pos] = ' ';
                    pos = pos + 1;
                }
                while (state_name[j]) {
                    if (pos < max - 1) {
                        dst[pos] = state_name[j];
                        pos = pos + 1;
                    }
                    j = j + 1;
                }
                if (pos < max - 1) {
                    dst[pos] = ' ';
                    pos = pos + 1;
                }
                if (!name[0]) {
                    name = "?";
                }
                j = 0;
                while (name[j]) {
                    if (pos < max - 1) {
                        dst[pos] = name[j];
                        pos = pos + 1;
                    }
                    j = j + 1;
                }
                if (pos < max - 1) {
                    dst[pos] = '\n';
                    pos = pos + 1;
                }
                dst[pos] = 0;
                arch_space_write(current, addr, dst, pos + 1);
                lock_release(&proc_lock);
                return 1;
            }
            seen = seen + 1;
        }
    }
    lock_release(&proc_lock);
    return 0;
}
