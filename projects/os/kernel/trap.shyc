#![no_main]

#include "arch.h"

#include <stdint.shyh>
#include "fs.h"
#include "lock.h"
#include "trap.h"
#include "proc.h"
#include "memlayout.h"

pub fn uart_putc(int c);
pub fn uart_getc(void) -> int;
pub proc *current;

static int user_range_ok(unsigned int addr, unsigned int n) {
    if (addr > USER_SEG_SIZE) {
        return 0;
    }
    if (n > USER_SEG_SIZE) {
        return 0;
    }
    if (addr + n < addr) {
        return 0;
    }
    if (addr + n > USER_SEG_SIZE) {
        return 0;
    }
    return 1;
}

static int sys_write(int fd, unsigned int buf, unsigned int n) {

    if (!user_range_ok(buf, n)) {
        return -1;
    }

    if (fd != 1 || current->stdout_fd >= 3) {
        return file_write(fd, (const void *)buf, n);
    }

    for (unsigned int i = 0; i < n; i++) {
        unsigned char c;
        arch_space_read(current, &c, buf + i, 1);
        uart_putc(c);
    }
    return (int)n;
}

static int sys_read(int fd, unsigned int buf, unsigned int n) {
    unsigned int i;

    if (!user_range_ok(buf, n)) {
        return -1;
    }
    if (n == 0) {
        return 0;
    }

    if (fd == 0 && current->stdin_fd < 3) {
            i = 0;
        while (i < n) {
            int c = uart_getc();
            if (c < 0) {
                continue;
            }
            if (c == 0) {
                if (i == 0) {
                    arch_shutdown(0);
                    return 0;
                }
                return (int)i;
            }
            unsigned char byte = (unsigned char)c;
            arch_space_write(current, buf + i, &byte, 1);
            i = i + 1;
            if (c == '\n') {
                break;
            }
        }
        return (int)i;
    }

    if (fd >= 3) {
        return file_read(fd, (void *)buf, n);
    }
    if (fd == 0) {
        return file_read(fd, (void *)buf, n);
    }

    return -1;
}

static void finish_file_result(int r) {
    if (file_result_blocked(r)) {
        ctx_retry_current_syscall();
        return;
    }
    ctx_set_current_ret(r);
    proc_set_current_state(RUNNABLE);
}

static void halt_if_no_user_work(void) {
    if (current == 0) {
        arch_shutdown(1);
    }
    if (getpid() == 1 || !proc_live_non_idle_exists()) {
        arch_shutdown(0);
    }
}

static void exit_if_killed(void) {
    if (proc_current_killed_runnable()) {
        exit(-1);
        halt_if_no_user_work();
    }
}

pub fn syscall_dispatch(int number, unsigned int a0, unsigned int a1, unsigned int a2) -> int {
    if (number == 1) {
        int pid = fork();
        proc_set_current_state(RUNNABLE);
        return pid;
    }
    if (number == 2) {
        proc_set_current_state(RUNNABLE);
        return 0;
    }
    if (number == 3) {
        proc_set_current_state(RUNNABLE);
        return getpid();
    }
    if (number == 4) {
        exit(a0);
        halt_if_no_user_work();
        return 0;
    }
    if (number == 5) {
        int r = sys_write(a0, a1, a2);
        finish_file_result(r);
        return r;
    }
    if (number == 6) {
        int r = sys_read(a0, a1, a2);
        finish_file_result(r);
        return r;
    }
    if (number == 7) {
        int r = sys_exec((const char *)a0, (const char *)a1);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 8) {
        int r = wait((int *)a0);
        if (!proc_current_state_is(SLEEPING)) {
            proc_set_current_state(RUNNABLE);
        }
        return r;
    }
    if (number == 9) {
        int r = file_open((const char *)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 10) {
        int r = file_close_fd(a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 11) {
        int r = kill(a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 12) {
        int r = sleep(a0);
        if (!proc_current_state_is(SLEEPING)) {
            proc_set_current_state(RUNNABLE);
        }
        return r;
    }
    if (number == 13) {
        wakeup(a0);
        proc_set_current_state(RUNNABLE);
        return 0;
    }
    if (number == 14) {
        int r = p3_counter_op(a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 15) {
        int r = file_pipe((int *)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 16) {
        int r = file_dup2(a0, a1);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 17) {
        int r = file_create((const char *)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 18) {
        int r = fs_dirent(a0, (char *)a1, a2);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 19) {
        int r = fs_mkdir((const char *)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 20) {
        int r = fs_rm((const char *)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 21) {
        int r = proc_psline(a0, (char *)a1, a2);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    if (number == 22) {
        int r = proc_sbrk((int)a0);
        proc_set_current_state(RUNNABLE);
        return r;
    }
    proc_set_current_state(RUNNABLE);
    return -1;
}

pub fn trap_handler(uint32_t cause, uint32_t r0, uint32_t r1, uint32_t r2, uint32_t r3) {
    if (cause == 1) {
        ctx_set_current_ret((uint32_t)syscall_dispatch((int)r0, r1, r2, r3));
        exit_if_killed();
    } else if (cause == 2) {
        proc_set_current_state(RUNNABLE);
        arch_set_timer(100);
        exit_if_killed();
    } else if (cause == 6) {
        // 用户态写 EXIT：模拟器把退出码放在 0x，这里只结束当前进程。
        if (current != 0 && getpid() != 0) {
            exit((int)r0);
            halt_if_no_user_work();
        } else {
            arch_shutdown(1);
        }
    } else if (cause == 3 || cause == 4 || cause == 5) {
        if (current != 0 && getpid() != 0) {
            exit((int)cause);
            halt_if_no_user_work();
        } else {
            arch_shutdown(1);
        }
    } else {
        arch_shutdown(1);
    }
}
