#![no_main]

/* ShyISA address spaces are hardware segments: a process owns one segment and
   the `segs`/`sege` registers add its base to every user address. */
#include "../../kernel/arch.h"
#include "../../kernel/memlayout.h"
#include "../../kernel/trap.h"
#include "../../kernel/proc.h"

pub fn seg_alloc(void) -> unsigned int;
pub fn seg_free(unsigned int base);
void *memcpy(void *dst, const void *src, unsigned int n);

pub fn arch_user_ptr(proc *p, unsigned int user_addr) -> void * {
    return (void *)(p->segbase + user_addr);
}

pub fn arch_space_alloc(proc *p) {
    p->segbase = seg_alloc();
}

pub fn arch_space_free(proc *p) {
    if (p->segbase != 0) {
        seg_free(p->segbase);
    }
}

// 段地址与长度都是 4 字节对齐。逐字搬运/清零是冷启动与 fork 的热路径：
// ShyISA 没有基址+偏移寻址，C 循环每轮要重算一次地址，这里用内联汇编把
// 一次搬运压到 9 条指令。
static void copy_word_count(void *dst, const void *src, unsigned int words) {
    asm!(dst, src, words) {
        ".Lcopy_words:\n"
        "equn 6x 0\n"
        "jmpn .Lcopy_words_done\n"
        "geta 1x 5x\n"
        "puta 4x 1x\n"
        "addn 4x 4\n"
        "addn 5x 4\n"
        "subn 6x 1\n"
        "ujmpn .Lcopy_words\n"
        ".Lcopy_words_done:\n"
    };
}

static void zero_word_count(unsigned int *dst, unsigned int words) {
    asm!(dst, words) {
        "setn 1x 0\n"
        ".Lzero_words:\n"
        "equn 5x 0\n"
        "jmpn .Lzero_words_done\n"
        "puta 4x 1x\n"
        "addn 4x 4\n"
        "subn 5x 1\n"
        "ujmpn .Lzero_words\n"
        ".Lzero_words_done:\n"
    };
}

pub fn arch_space_copy(proc *parent, proc *child) -> int {
    copy_word_count((void *)child->segbase, (void *)parent->segbase, USER_SEG_SIZE / 4);
    return 0;
}

// 镜像只覆盖段的前 n 个字节，其余部分清零，复用旧段时不会读到上一份数据。
static void clear_tail(proc *p, unsigned int n) {
    unsigned int *memory = (unsigned int *)p->segbase;
    unsigned int start = n / 4;
    zero_word_count(memory + start, USER_SEG_SIZE / 4 - start);
}

pub fn arch_space_load(proc *p, const void *src, unsigned int n) {
    clear_tail(p, n);
    if (((unsigned int)src & 3) == 0 && (n & 3) == 0) {
        copy_word_count((void *)p->segbase, src, n / 4);
    } else {
        arch_space_write(p, 0, src, n);
    }
}

pub fn arch_user_sp(unsigned int stack_base) -> unsigned int {
    return stack_base; /* ShyISA frames grow upward. */
}

pub fn arch_space_write(proc *p, unsigned int user_addr, const void *src, unsigned int n) {
    memcpy((void *)(p->segbase + user_addr), src, n);
}

pub fn arch_space_read(proc *p, void *dst, unsigned int user_addr, unsigned int n) {
    memcpy(dst, (void *)(p->segbase + user_addr), n);
}

pub fn ctx_set_ret(context *ctx, int value) {
    ctx->regs[1] = (unsigned int)value;
}
